package dev.cajeta.jinja.test;

import dev.cajeta.unit.Assert;
import dev.cajeta.jinja.Environment;
import dev.cajeta.jinja.FileSystemLoader;
import dev.cajeta.jinja.Template;
import dev.cajeta.jinja.JinjaException;
import cajeta.codec.json.Json;
import cajeta.codec.json.JsonValue;
import cajeta.codec.json.JsonObject;
import cajeta.io.file.File;
import cajeta.lang.String;

/**
 * cajeta-jinja plan Unit 1 TDD — the reference harness.
 *
 * 1.1.2: render a fixture through the engine and compare BYTES against
 * the Jinja2-generated expected.out, reporting the first differing
 * offset with surrounding context (a whitespace diff must be readable).
 * 1.1.3: Environment settings round-trip.
 * 1.3.1: the trivial literal fixture proves the whole loop —
 * generator -> fixture -> engine -> byte comparison — before any
 * language work exists.
 *
 * Fixture root: `src/test/fixtures`, relative to the repo root —
 * run-tests.sh executes the suite from there (the cajeta-llama
 * pattern).
 */
public class HarnessTest {

    public HarnessTest() { return; }

    static #String fixtureRoot() {
        return "src/test/fixtures";
    }

    /**
     * The harness core (1.1.2): render `template.j2` under settings
     * against `context.json`, byte-compare with `expected.out`. On a
     * mismatch the failure message carries the first differing offset
     * and a +/-16-byte window of both sides, control bytes escaped —
     * readable for whitespace diffs.
     */
    /** Build the Environment from the fixture's settings.json — the
     *  SAME file the generator fed to Jinja2, so the two sides can
     *  never drift. Missing file = all defaults. */
    static #Environment envFor(String base) {
        Environment env = heap Environment();
        env.loader(#heap FileSystemLoader(base));
        int8[] raw #= File.readAllBytes(base + "/settings.json");
        JsonValue v #= Json.parse(raw, (int64) raw.count());
        JsonObject o = v.object();
        if (o == null) {
            return #= env;
        }
        JsonValue f = o.get("trim_blocks");
        if (f != null) { env.trimBlocks(f.asBoolean()); }
        f = o.get("lstrip_blocks");
        if (f != null) { env.lstripBlocks(f.asBoolean()); }
        f = o.get("autoescape");
        if (f != null) { env.autoescape(f.asBoolean()); }
        f = o.get("strict_undefined");
        if (f != null) { env.strictUndefined(f.asBoolean()); }
        f = o.get("now_epoch_seconds");
        if (f != null) { env.nowEpochSeconds(f.asInt64()); }
        return #= env;
    }

    static void renderAndCompare(String fixture) {
        String root #= HarnessTest.fixtureRoot();
        String base = root + "/" + fixture;
        Environment env #= HarnessTest.envFor(base);
        int8[] tplBytes #= File.readAllBytes(base + "/template.j2");
        String tpl #= heap String(#tplBytes, (int32) tplBytes.count());
        int8[] want #= File.readAllBytes(base + "/expected.out");

        Template t #= env.compile(tpl);
        int8[] ctxBytes #= File.readAllBytes(base + "/context.json");
        JsonValue ctx #= Json.parse(ctxBytes, (int64) ctxBytes.count());
        String got #= t.render(ctx);
        int8[] gotBytes #= got.toBytes();

        int32 wn = (int32) want.count();
        int32 gn = got.byteLength();
        int32 n = wn;
        if (gn < n) { n = gn; }
        int32 diff = -1;
        int32 i = 0;
        while (i < n) {
            if (want[i] != gotBytes[i]) { diff = i; break; }
            i = i + 1;
        }
        if (diff < 0 && wn != gn) { diff = n; }
        if (diff >= 0) {
            Assert.fail(fixture + ": first difference at byte " + diff
                + " (expected " + wn + " bytes, got " + gn + ")\n"
                + "  expected[" + diff + "-]: "
                + HarnessTest.window(want, wn, diff) + "\n"
                + "  actual  [" + diff + "-]: "
                + HarnessTest.window(gotBytes, gn, diff));
            return;
        }
        Assert.isTrue(true);
    }

    /** A +/-16-byte window around `at`, control bytes rendered as
     *  escapes so a whitespace diff is readable (1.1.2). */
    static #String window(int8[] bytes, int32 n, int32 at) {
        int32 from = at - 16;
        if (from < 0) { from = 0; }
        int32 to = at + 16;
        if (to > n) { to = n; }
        String out = "";
        int32 i = from;
        while (i < to) {
            int32 b = ((int32) bytes[i]) & 255;
            if (b == 10) { out = out + "\\n"; }
            else if (b == 13) { out = out + "\\r"; }
            else if (b == 9) { out = out + "\\t"; }
            else if (b < 32 || b > 126) { out = out + "\\x" + b; }
            else {
                int8[] one #= heap int8[1];
                one[0] = (int8) b;
                String c #= heap String(#one, 1);
                out = out + c;
            }
            i = i + 1;
        }
        return "" + out;
    }

    /** 1.1.3 — every setting reads back what was set, and compile()
     *  snapshots them (later env mutation must not change a compiled
     *  template's behaviour — asserted structurally in Unit 2+, here
     *  the round-trip itself). */
    @Test
    public void settingsRoundTrip() {
        Environment env = heap Environment()
            .trimBlocks(true)
            .lstripBlocks(true)
            .autoescape(true)
            .strictUndefined(true)
            .nowEpochSeconds((int64) 1755600000);
        Assert.isTrue(env.isTrimBlocks());
        Assert.isTrue(env.isLstripBlocks());
        Assert.isTrue(env.isAutoescape());
        Assert.isTrue(env.isStrictUndefined());
        Assert.isTrue(env.getNowEpochSeconds() == (int64) 1755600000);

        Environment off = heap Environment();
        Assert.isTrue(!off.isTrimBlocks());
        Assert.isTrue(!off.isLstripBlocks());
        Assert.isTrue(!off.isAutoescape());
        Assert.isTrue(!off.isStrictUndefined());
        Assert.isTrue(off.getNowEpochSeconds() == (int64) 0);
    }

    /** 1.3.1 — the trivial literal template renders byte-exact through
     *  the whole loop: Jinja2 generated expected.out, the engine must
     *  match it. */
    @Test
    public void trivialLiteralRendersByteExact() {
        HarnessTest.renderAndCompare("literal-passthrough");
    }

    /** Spec 2.22 discipline from day one: a construct the engine cannot
     *  render fails LOUDLY, naming the construct and line — never
     *  renders something subtly wrong. The guard construct moves as
     *  units land (expressions, statements, macros, inheritance); it
     *  sits on `{% do %}` — outside the supported set — and fires at
     *  COMPILE time (spec 5.2/5.3). */
    @Test
    public void unsupportedConstructFailsLoudly() {
        Environment env = heap Environment();
        boolean threw = false;
        try {
            Template t #= env.compile(
                "line one\n{% do thing %}\n");
            threw = t == null;   // unreachable
        } catch (JinjaException e) {
            threw = true;
            Assert.isTrue(e.line == 2);
        }
        Assert.isTrue(threw);
    }

    /** 2.1.2/2.1.3 (defaults): comment tags with BOTH flags off — the
     *  Jinja default; every newline and indent survives except where
     *  explicit dashes strip. */
    @Test
    public void whitespaceDefaultsMatch() {
        HarnessTest.renderAndCompare("ws-default");
    }

    /** 2.1.2: trim_blocks alone. */
    @Test
    public void whitespaceTrimBlocksMatches() {
        HarnessTest.renderAndCompare("ws-trim");
    }

    /** 2.1.3: lstrip_blocks alone. */
    @Test
    public void whitespaceLstripBlocksMatches() {
        HarnessTest.renderAndCompare("ws-lstrip");
    }

    /** 2.1.5: the transformers combination (both on) — the chat-template
     *  environment. Includes 2.1.4's explicit dashes overriding it. */
    @Test
    public void whitespaceTransformersComboMatches() {
        HarnessTest.renderAndCompare("ws-both");
    }
}
