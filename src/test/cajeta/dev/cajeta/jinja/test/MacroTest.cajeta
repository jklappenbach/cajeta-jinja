package dev.cajeta.jinja.test;

import dev.cajeta.unit.Assert;
import dev.cajeta.jinja.Environment;
import dev.cajeta.jinja.Template;
import dev.cajeta.jinja.JinjaException;
import cajeta.codec.json.Json;
import cajeta.codec.json.JsonValue;
import cajeta.lang.String;

/**
 * cajeta-jinja plan Unit 6 TDD — macros, call blocks, filter blocks,
 * raw.
 *
 * Oracle-pinned semantics: macros are DEFINITION-ORDER (calling before
 * the definition is an undefined error); a macro body sees the
 * template's TOP-LEVEL scope and its own parameters but NOT the call
 * site's locals; `set` inside a macro does not leak; defaults evaluate
 * at CALL time in the macro's visible scope; `caller()` renders the
 * call block with CALL-SITE visibility plus the block's parameters;
 * recursion works (llama's render_extra_keys shape).
 */
public class MacroTest {

    public MacroTest() { return; }

    /** 6.1.1 — positional/keyword/defaulted params, recursion,
     *  scoping, macro-as-value (.name / is defined). */
    @Test
    public void macrosMatch() {
        HarnessTest.renderAndCompare("stmt-macro");
    }

    /** 6.1.2 — {% call %} / caller(), with and without parameters. */
    @Test
    public void callBlocksMatch() {
        HarnessTest.renderAndCompare("stmt-call");
    }

    /** 6.1.3 — {% filter %} blocks and {% raw %}. */
    @Test
    public void filterBlocksAndRawMatch() {
        HarnessTest.renderAndCompare("flt-raw");
    }

    /** 6.3.1 — the tool-call chat template (qwen3coder: macros with
     *  defaults, loop filters, tojson, tests, whitespace control)
     *  byte-exact under the transformers settings. */
    @Test
    public void toolCallTemplateMatches() {
        HarnessTest.renderAndCompare("qwen3coder-tool");
    }

    /** Calling before definition is an error, as is caller() outside
     *  a call block, and extra positional args fail loudly. */
    @Test
    public void macroErrorsAreLoud() {
        Environment env = heap Environment();
        JsonValue ctx #= Json.parse("{}");

        Template t #= env.compile(
            "{{ m() }}{% macro m() %}x{% endmacro %}");
        boolean threw = false;
        try {
            String out #= t.render(ctx);
            threw = out == null;             // never
        } catch (JinjaException e) {
            threw = true;
        }
        Assert.isTrue(threw);

        Template t2 #= env.compile(
            "{% macro m() %}{{ caller() }}{% endmacro %}{{ m() }}");
        boolean threw2 = false;
        try {
            String out2 #= t2.render(ctx);
            threw2 = out2 == null;           // never
        } catch (JinjaException e2) {
            threw2 = true;
        }
        Assert.isTrue(threw2);

        Template t3 #= env.compile(
            "{% macro one(a) %}{{ a }}{% endmacro %}{{ one(1, 2) }}");
        boolean threw3 = false;
        try {
            String out3 #= t3.render(ctx);
            threw3 = out3 == null;           // never
        } catch (JinjaException e3) {
            threw3 = true;
        }
        Assert.isTrue(threw3);
    }
}
