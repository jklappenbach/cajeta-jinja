package dev.cajeta.jinja;

import cajeta.lang.String;

/**
 * The parsed template — a FLAT node table (plan 2.2.3, the sibling of
 * `Tok`): records of `W` int32 fields in one array plus a parallel
 * String payload. A pointer-chasing AST of small classes would cost an
 * allocation per node and buy nothing, since every traversal is an
 * index walk. Statement sequences chain through `nx`; so do argument
 * lists, list items, dict pairs, and comparison-chain links.
 *
 * String payloads are OWNED — the Parser mints them from Tok spans, so
 * the token stream (and the Lexer under it) can drop once parsing
 * finishes while the compiled template lives on (spec 3.2's discipline
 * applied to the AST itself).
 */
final class Node {

    static final int32 W = 8;      // kind, a, b, c, d, nx, line, e

    // ── statement kinds ────────────────────────────────────────────────
    static final int32 N_TEXT = 0;   // str = literal text
    static final int32 N_OUT = 1;    // a = expr
    static final int32 N_IF = 2;     // a = cond, b = then, c = else|-1
                                     //   (elif = nested N_IF in c)
    static final int32 N_FOR = 3;    // a = iter, b = body, c = else|-1,
                                     // str = "i" or "a,b,c", d = count,
                                     // e = loop filter|-1
    static final int32 N_SET = 4;    // str = "x" or "ns.attr";
                                     // a = expr|-1, b = block body|-1
    static final int32 N_WITH = 5;   // a = E_KWARG chain, b = body
    static final int32 N_BREAK = 6;
    static final int32 N_CONTINUE = 7;
    static final int32 N_MACRO = 8;  // str = name, a = params chain
                                     //   (E_KWARG: str = pname,
                                     //    a = default|-1), b = body
    static final int32 N_CALLBLK = 9; // a = the E_CALL, b = body,
                                     // c = block params chain
    static final int32 N_FILTBLK = 10; // str = filter, a = args, b = body

    // ── expression kinds ───────────────────────────────────────────────
    static final int32 E_STR = 10;   // str = unescaped value
    static final int32 E_NUM = 11;   // str = raw text, d = 1 if float
    static final int32 E_TRUE = 12;
    static final int32 E_FALSE = 13;
    static final int32 E_NONE = 14;
    static final int32 E_NAME = 15;  // str
    static final int32 E_ATTR = 16;  // a = obj, str = attr
    static final int32 E_INDEX = 17; // a = obj, b = index
    static final int32 E_SLICE = 18; // a = obj, b = start|-1, c = stop|-1,
                                     // e = step|-1
    static final int32 E_CALL = 19;  // a = callee, b = args chain
    static final int32 E_FILTER = 20; // a = value, str = name, b = args
    static final int32 E_TEST = 21;  // a = value, str = name, d = negated,
                                     // b = args
    static final int32 E_BIN = 22;   // a, b, str = op
    static final int32 E_NOT = 23;   // a
    static final int32 E_NEG = 24;   // a
    static final int32 E_POS = 25;   // a  (unary +)
    static final int32 E_COND = 26;  // a = cond, b = then, c = else|-1
    static final int32 E_LIST = 27;  // a = items chain
    static final int32 E_DICT = 28;  // a = pairs chain
    static final int32 E_PAIR = 29;  // a = key, b = value
    static final int32 E_KWARG = 30; // str = name, a = value
    static final int32 E_CMP = 31;   // a = first operand, b = op chain
    static final int32 E_CMPOP = 32; // str = op, a = operand, nx = next
                                     //   ("==", "!=", "<", "<=", ">",
                                     //    ">=", "in", "notin") — Jinja
                                     //   comparisons CHAIN (1 < 2 < 3)

    int32[] f;
    String[] str;
    int32 n;
    int32 root;

    Node(int32 capacity) {
        int32 c = 64;
        while (c < capacity) {
            c = c * 2;
        }
        this.f = heap int32[c * Node.W];
        this.str = heap String[c];
        this.n = 0;
        this.root = 0 - 1;
    }

    int32 add(int32 kind, int32 line) {
        if (this.n >= (int32) this.str.count()) {
            int32 cap = this.n * 2;
            int32[] nf = heap int32[cap * Node.W];
            String[] ns = heap String[cap];
            int32 i = 0;
            while (i < this.n * Node.W) {
                nf[i] = this.f[i];
                i = i + 1;
            }
            i = 0;
            while (i < this.n) {
                ns[i] = this.str[i];
                i = i + 1;
            }
            this.f #= nf;
            this.str #= ns;
        }
        int32 at = this.n;
        int32 base = at * Node.W;
        this.f[base] = kind;
        this.f[base + 1] = 0 - 1;
        this.f[base + 2] = 0 - 1;
        this.f[base + 3] = 0 - 1;
        this.f[base + 4] = 0;
        this.f[base + 5] = 0 - 1;
        this.f[base + 6] = line;
        this.f[base + 7] = 0 - 1;
        this.n = at + 1;
        return at;
    }

    int32 k(int32 i) { return this.f[i * Node.W]; }
    int32 a(int32 i) { return this.f[i * Node.W + 1]; }
    int32 b(int32 i) { return this.f[i * Node.W + 2]; }
    int32 c(int32 i) { return this.f[i * Node.W + 3]; }
    int32 d(int32 i) { return this.f[i * Node.W + 4]; }
    int32 nx(int32 i) { return this.f[i * Node.W + 5]; }
    int32 line(int32 i) { return this.f[i * Node.W + 6]; }
    int32 e(int32 i) { return this.f[i * Node.W + 7]; }

    void setA(int32 i, int32 v) { this.f[i * Node.W + 1] = v; }
    void setB(int32 i, int32 v) { this.f[i * Node.W + 2] = v; }
    void setC(int32 i, int32 v) { this.f[i * Node.W + 3] = v; }
    void setD(int32 i, int32 v) { this.f[i * Node.W + 4] = v; }
    void setNx(int32 i, int32 v) { this.f[i * Node.W + 5] = v; }
    void setE(int32 i, int32 v) { this.f[i * Node.W + 7] = v; }

    void setStr(int32 i, #String s) {
        this.str[i] #= s;
    }

    String strOf(int32 i) {
        return this.str[i];
    }
}
