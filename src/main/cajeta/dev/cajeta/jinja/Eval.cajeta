            if (mn != null) {
                return #Eval.copy(mn);
            }
        }
        int32 cyId = this.handleId(o, "__jinja_cycler__");
        if (cyId >= 0 && name.equals("current")) {
            JsonObject e = this.nsStore[cyId].object();
            JsonArray items = e.get("items").array();
            int32 pos = (int32) e.get("pos").asInt64();
            return #Eval.copy(items.get(pos));
        }
        int32 nsId = this.nsIdOf(o);
        if (nsId >= 0) {
            JsonValue got = this.nsStore[nsId].object().get(name);
            if (got != null) {
                return #Eval.copy(got);
            }
            this.lastUndef #= "" + name;
            return null;
        }
        if (o.kind() == JsonValue.OBJECT) {
            JsonValue got = o.object().get(name);
            if (got != null) {
                return #Eval.copy(got);
            }
        }
        // Missing attribute -> undefined (lenient until USED).
        this.lastUndef #= "" + name;
        return null;
    }

    #JsonValue indexOf(JsonValue o, JsonValue idx, int32 line) {
        if (idx == null) {
            this.undefErr(line);
        }
        if (o.kind() == JsonValue.ARRAY) {
            JsonArray a = o.array();
            if (Eval.isNumberish(idx) == false) {
                this.err("list indices must be integers", line);
            }
            int32 x = (int32) Eval.toI64(idx);
            if (x < 0) {
                x = a.count() + x;
            }
            if (x < 0 || x >= a.count()) {
                this.lastUndef = "list index out of range";
                return null;
            }
            return #Eval.copy(a.get(x));
        }
        if (o.kind() == JsonValue.STRING) {
            if (Eval.isNumberish(idx) == false) {
                this.err("string indices must be integers", line);
            }
            int8[] s = o.asBytes();
            int32 n = o.asBytesLength();
            int32 x2 = (int32) Eval.toI64(idx);
            if (x2 < 0) {
                x2 = n + x2;
            }
            if (x2 < 0 || x2 >= n) {
                this.lastUndef = "string index out of range";
                return null;
            }
            int8[] one = heap int8[1];
            one[0] = s[x2];
            JsonValue v = heap JsonValue();
            v.setStringOwned(#one, 1);
            return #v;
        }
        if (o.kind() == JsonValue.OBJECT) {
            String key #= this.text(idx, line);
            return #this.member(o, key);
        }
        this.err("value is not subscriptable", line);
        return null;                         // unreachable
    }

    /** Python slice semantics, step included ([::-1] reverses). */
    #JsonValue evalSlice(int32 i) {
        int32 line = this.nd.line(i);
        JsonValue o #= this.eval(this.nd.a(i));
        if (o == null) {
            this.undefErr(line);
        }
        boolean isStr = o.kind() == JsonValue.STRING;
        if (isStr == false && o.kind() != JsonValue.ARRAY) {
            this.err("value is not sliceable", line);
        }
        int32 n = 0;
        if (isStr) {
            n = o.asBytesLength();
        } else {
            n = o.array().count();
        }
        int64 step = 1;
        if (this.nd.e(i) >= 0) {
            JsonValue sv #= this.eval(this.nd.e(i));
            if (Eval.isNumberish(sv) == false) {
                this.err("slice step must be an integer", line);
            }
            step = Eval.toI64(sv);
            if (step == 0) {
                this.err("slice step cannot be zero", line);
            }
        }
        int64 start = 0;
        int64 stop = n;
        if (step < 0) {
            start = n - 1;
            stop = 0 - 1;
        }
        if (this.nd.b(i) >= 0) {
            JsonValue bv #= this.eval(this.nd.b(i));
            start = Eval.toI64(bv);
            if (start < 0) {
                start = start + n;
            }
            if (start < 0) {
                if (step > 0) { start = 0; } else { start = 0 - 1; }
            }
            if (start >= n) {
                if (step > 0) { start = n; } else { start = n - 1; }
            }
        }
        if (this.nd.c(i) >= 0) {
            JsonValue cv #= this.eval(this.nd.c(i));
            stop = Eval.toI64(cv);
            if (stop < 0) {
                stop = stop + n;
            }
            if (stop < 0) {
                if (step > 0) { stop = 0; } else { stop = 0 - 1; }
            }
            if (stop > n) {
                stop = n;
            }
        }
        if (isStr) {
            Buf b = heap Buf();
            int8[] s = o.asBytes();
            int64 x = start;
            while ((step > 0 && x < stop) || (step < 0 && x > stop)) {
                b.addByte(((int32) s[(int32) x]) & 255);
                x = x + step;
            }
            return #Eval.str(b.take());
        }
        JsonArray src = o.array();
        JsonArray dst = heap JsonArray();
        int64 x2 = start;
        while ((step > 0 && x2 < stop) || (step < 0 && x2 > stop)) {
            dst.add(Eval.copy(src.get((int32) x2)));
            x2 = x2 + step;
        }
        JsonValue v = heap JsonValue();
        v.setArray(#dst);
        return #v;
    }

    /** `is` tests. `defined`/`undefined` are the spec-2.23 distinction
     *  and never count as a read, even under strict. */
    #JsonValue evalTest(int32 i) {
        String name = this.nd.strOf(i);
        JsonValue v #= this.eval(this.nd.a(i));
        boolean r = this.applyTest(name, v, this.nd.b(i),
            this.nd.line(i));
        if (this.nd.d(i) == 1) {
            r = r == false;
        }
        return #Eval.bool(r);
    }

    /** The spec-2.18 test set, by name — shared with select/reject/
     *  selectattr/rejectattr. `args` is the argument node chain (the
     *  no-paren single-arg form lands here too). Unknown names fail
     *  LOUDLY (spec 2.22). Note `true is integer` is False — Python
     *  bools are excluded from integer/float, matching the oracle. */
    boolean applyTest(String name, JsonValue v, int32 args,
            int32 line) {
        if (name.equals("defined")) {
            return v != null;
        }
        if (name.equals("undefined")) {
            return v == null;
        }
        if (name.equals("none")) {
            return v != null && v.kind() == JsonValue.NULL;
        }
        if (name.equals("boolean")) {
            return v != null && v.kind() == JsonValue.BOOLEAN;
        }
        if (name.equals("true")) {
            return v != null && v.kind() == JsonValue.BOOLEAN
                && v.asBoolean();
        }
        if (name.equals("false")) {
            return v != null && v.kind() == JsonValue.BOOLEAN
                && v.asBoolean() == false;
        }
        if (name.equals("integer")) {
            return v != null && v.kind() == JsonValue.NUMBER
                && v.isFloat() == false;
        }
        if (name.equals("float")) {
            return v != null && v.kind() == JsonValue.NUMBER
                && v.isFloat();
        }
        if (name.equals("number")) {
            return v != null && (v.kind() == JsonValue.NUMBER
                || v.kind() == JsonValue.BOOLEAN);
        }
        if (name.equals("string")) {
            return v != null && v.kind() == JsonValue.STRING;
        }
        if (name.equals("mapping")) {
            return v != null && v.kind() == JsonValue.OBJECT;
        }
        if (name.equals("sequence") || name.equals("iterable")) {
            return v != null && (v.kind() == JsonValue.ARRAY
                || v.kind() == JsonValue.STRING
                || v.kind() == JsonValue.OBJECT);
        }
        if (name.equals("callable")) {
            return this.handleId(v, "__jinja_joiner__") >= 0
                || (v != null && v.kind() == JsonValue.OBJECT
                    && v.object().containsKey("__jinja_callable__"));
        }
        if (name.equals("odd") || name.equals("even")) {
            if (v == null || v.kind() != JsonValue.NUMBER
                    || v.isFloat()) {
                this.err("'is " + name + "' needs an integer", line);
            }
            boolean odd = v.asInt64() % 2 != 0;
            if (name.equals("odd")) {
                return odd;
            }
            return odd == false;
        }
        if (name.equals("divisibleby")) {
            if (args < 0) {
                this.err("'is divisibleby' needs a number", line);
            }
            JsonValue d #= this.eval(args);
            if (v == null || Eval.isNumberish(v) == false
                    || Eval.isNumberish(d) == false) {
                this.err("'is divisibleby' needs numbers", line);
            }
            int64 dv = Eval.toI64(d);
            if (dv == 0) {
                this.err("'is divisibleby' by zero", line);
            }
            return Eval.toI64(v) % dv == 0;
        }
        if (name.equals("upper") || name.equals("lower")) {
            if (v == null || v.kind() != JsonValue.STRING) {
                return false;
            }
            boolean anyLetter = false;
            boolean wantUpper = name.equals("upper");
            int8[] sb = v.asBytes();
            int32 n = v.asBytesLength();
            int32 i2 = 0;
            while (i2 < n) {
                int32 c = ((int32) sb[i2]) & 255;
                boolean isUp = c >= 65 && c <= 90;
                boolean isLo = c >= 97 && c <= 122;
                if (isUp || isLo) {
                    anyLetter = true;
                    if (wantUpper && isLo) {
                        return false;
                    }
                    if (wantUpper == false && isUp) {
                        return false;
                    }
                }
                i2 = i2 + 1;
            }
            return anyLetter;
        }
        if (name.equals("sameas")) {
            if (args < 0) {
                this.err("'is sameas' needs an argument", line);
            }
            JsonValue o #= this.eval(args);
            if (v == null || o == null) {
                return v == null && o == null;
            }
            int32 ka = v.kind();
            if (ka != o.kind()) {
                return false;
            }
            if (ka == JsonValue.NULL) {
                return true;
            }
            if (ka == JsonValue.BOOLEAN) {
                return v.asBoolean() == o.asBoolean();
            }
            if (ka == JsonValue.NUMBER) {
                // CPython interns small ints; approximate with value
                // equality (the oracle agrees for the corpus).
                return this.eq(v, o, line);
            }
            if (ka == JsonValue.OBJECT) {
                int32 va = this.nsIdOf(v);
                if (va >= 0) {
                    return va == this.nsIdOf(o);
                }
            }
            return false;
        }
        if (name.equals("in")) {
            if (args < 0) {
                this.err("'is in' needs a sequence", line);
            }
            JsonValue seq #= this.eval(args);
            return this.contains(seq, v, line);
        }
        if (name.equals("eq") || name.equals("equalto")) {
            JsonValue o #= this.eval(args);
            return this.eq(v, o, line);
        }
        if (name.equals("ne")) {
            JsonValue o #= this.eval(args);
            return this.eq(v, o, line) == false;
        }
        if (name.equals("lt") || name.equals("gt") || name.equals("le")
                || name.equals("ge")) {
            if (args < 0) {
                this.err("'is " + name + "' needs an argument", line);
            }
            JsonValue o #= this.eval(args);
            int32 c = this.ordCmp(v, o, line);
            if (name.equals("lt")) { return c < 0; }
            if (name.equals("gt")) { return c > 0; }
            if (name.equals("le")) { return c <= 0; }
            return c >= 0;
        }
        this.err("unsupported test 'is " + name + "'", line);
        return false;                        // unreachable
    }

    /** Deterministic lorem ipsum. Jinja's is RANDOM, so no template
