package dev.cajeta.jinja;

import cajeta.codec.json.JsonArray;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonValue;
import cajeta.lang.Math;
import cajeta.lang.String;

/**
 * The expression evaluator (plan 3.2.2). Values are `JsonValue` — the
 * consumer's own shape (spec 3.1) — with cajeta `null` standing for
 * Jinja's *undefined*, distinct from `JsonValue` NULL which is Jinja's
 * `none`; `is defined` is exactly that distinction (spec 2.23).
 *
 * The undefined-use matrix mirrors Jinja2 3.1.6 (oracle-verified):
 * printing, truthiness, `~`, `==`, and `in` are lenient in default
 * mode ('' / False); attribute and index access, arithmetic, and
 * ordering comparisons raise in BOTH modes; strict mode also raises on
 * the lenient uses. `is defined` / `is undefined` never count as a
 * read.
 *
 * Numbers are int64 + float64 with Jinja's (Python's) semantics: `/`
 * is always float, `//` floors, `%` takes the divisor's sign, booleans
 * participate as 0/1 (`true == 1`). Float TEXT is Python-repr for
 * dyadic values (halves, quarters, ...) and integral floats ("2.0");
 * non-terminating expansions (0.1 + 0.2) diverge from CPython's
 * shortest-round-trip repr — the corpus keeps float output dyadic, and
 * a Ryu-style formatter is future work if a consumer ever needs it.
 *
 * Every value that lands in a scope or container OWNS its bytes
 * (spec 3.2): lookups copy, `str()` transfers a fresh buffer — the
 * exact discipline whose absence was cajeta-llama's dangling-borrow
 * defect class.
 */
final class Eval {

    // `nd` and `ctx` are VIEWS (§2.2): Template.render wires them in
    // right after construction and the Eval dies inside that call, so
    // the borrows never outlive their owners. They are deliberately NOT
    // constructor formals — a direct `this.field = formal` store is the
    // CAPTURED_BORROW_PARAM shape the ownership convention rejects; a
    // store from the owner's own frame is the carve-out for borrows the
    // caller can see are call-scoped.
    Node nd;
    JsonValue ctx;           // root context (borrow for the render call)
    boolean strict;
    boolean autoescape;
    int64 nowEpoch;          // injected clock; 0 = unset (spec 2.21)

    Buf out;
    String lastUndef;        // last name that resolved to undefined

    // scope frames above the context: for-iterations and with-blocks
    // push; `if` never does (oracle-verified Jinja scoping)
    String[] names;
    JsonValue[] vals;
    int32 depth;
    int32[] fbase;           // frame base stack; assign() binds in the
    int32 fdepth;            //   CURRENT frame only, lookup walks all

    // loopcontrols signals — cleared by the enclosing for
    boolean brk;
    boolean cont;

    // Macro table — populated in DEFINITION ORDER as N_MACRO executes
    // (calling before the definition is an undefined error, as Jinja).
    String[] macroNames;
    int32[] macroNodes;
    int32 macroN;

    // Macro visibility: a macro body sees frames [macroBase, depth)
    // (its own params/locals) plus the template's TOP-LEVEL frame
    // [0, rootEnd) — never the call site's locals (oracle-verified).
    // 0/-1 = not inside a macro (normal full visibility).
    int32 macroBase;
    int32 rootEnd;

    // The active {% call %} block for caller(): body chain, params
    // chain, and the CALL-SITE visibility to restore while rendering.
    int32 callerBody;
    int32 callerParams;
    int32 callerBase;
    int32 callerRootEnd;

    // Active-block super() chain: each entry is the N_BLOCK node
    // holding the NEXT level's body (or -1).
    int32[] supStack;
    int32 supN;

    // namespace() registry: handles are {"__jinja_ns__": id} objects
    // that COPY freely while the entry here stays shared — reference
    // semantics under the copy discipline
    JsonValue[] nsStore;
    int32 nsN;

    Eval() {
        this.nd = null;
        this.ctx = null;
        this.strict = false;
        this.autoescape = false;
        this.nowEpoch = 0;
        this.out = heap Buf();
        this.lastUndef = "";
        this.names = heap String[16];
        this.vals = heap JsonValue[16];
        this.depth = 0;
        this.fbase = heap int32[8];
        this.fbase[0] = 0;
        this.fdepth = 1;
        this.brk = false;
        this.cont = false;
        this.nsStore = heap JsonValue[4];
        this.nsN = 0;
        this.supStack = heap int32[8];
        this.supN = 0;
        this.macroNames = heap String[8];
        this.macroNodes = heap int32[8];
        this.macroN = 0;
        this.macroBase = 0;
        this.rootEnd = 0;
        this.callerBody = 0 - 1;
        this.callerParams = 0 - 1;
        this.callerBase = 0;
        this.callerRootEnd = 0;
    }

    int32 macroOf(String name) {
        int32 i = 0;
        while (i < this.macroN) {
            if (this.macroNames[i].equals(name)) {
                return this.macroNodes[i];
            }
            i = i + 1;
        }
        return 0 - 1;
    }

    void addMacro(String name, int32 node) {
        if (this.macroN >= (int32) this.macroNodes.count()) {
            String[] nn = heap String[this.macroN * 2];
            int32[] ni = heap int32[this.macroN * 2];
            int32 i = 0;
            while (i < this.macroN) {
                nn[i] = this.macroNames[i];
                ni[i] = this.macroNodes[i];
                i = i + 1;
            }
            this.macroNames #= nn;
            this.macroNodes #= ni;
        }
        String own = "" + name;
        this.macroNames[this.macroN] #= own;
        this.macroNodes[this.macroN] = node;
        this.macroN = this.macroN + 1;
    }

    int32 beginScope() {
        if (this.fdepth >= (int32) this.fbase.count()) {
            int32[] nf = heap int32[this.fdepth * 2];
            int32 i = 0;
            while (i < this.fdepth) {
                nf[i] = this.fbase[i];
                i = i + 1;
            }
            this.fbase #= nf;
        }
        this.fbase[this.fdepth] = this.depth;
        this.fdepth = this.fdepth + 1;
        return this.depth;
    }

    void endScope(int32 mark) {
        while (this.depth > mark) {
            this.depth = this.depth - 1;
            this.vals[this.depth] = null;
            this.names[this.depth] = null;
        }
        this.fdepth = this.fdepth - 1;
    }

    // ── scope ──────────────────────────────────────────────────────────

    void push(String name, #JsonValue v) {
        if (this.depth >= (int32) this.vals.count()) {
            int32 cap = this.depth * 2;
            String[] nn = heap String[cap];
            JsonValue[] nv = heap JsonValue[cap];
            int32 i = 0;
            while (i < this.depth) {
                nn[i] = this.names[i];
                nv[i] = this.vals[i];
                i = i + 1;
            }
            this.names #= nn;
            this.vals #= nv;
        }
        String own = "" + name;
        this.names[this.depth] #= own;
        this.vals[this.depth] #= v;
        this.depth = this.depth + 1;
    }

    /** Rebind or create in the CURRENT frame only — `set` inside a
     *  for-iteration or with-block shadows and then drops; `if` shares
     *  its enclosing frame. */
    void assign(String name, #JsonValue v) {
        int32 base = this.fbase[this.fdepth - 1];
        int32 i = this.depth - 1;
        while (i >= base) {
            if (this.names[i].equals(name)) {
                this.vals[i] #= v;
                return;
            }
            i = i - 1;
        }
        this.push(name, #v);
    }

    /** Frames first, then the root context; copies (spec 3.2), null on
     *  a miss (undefined) with the name remembered for diagnostics. */
    #JsonValue lookup(String name) {
        int32 stop = this.macroBase;
        int32 i = this.depth - 1;
        while (i >= stop) {
            if (this.names[i].equals(name)) {
                return #Eval.copy(this.vals[i]);
            }
            i = i - 1;
        }
        if (this.macroBase > 0) {
            // Inside a macro: the template's top-level frame only.
            i = this.rootEnd - 1;
            while (i >= 0) {
                if (this.names[i].equals(name)) {
                    return #Eval.copy(this.vals[i]);
                }
                i = i - 1;
            }
        }
        if (this.ctx != null && this.ctx.kind() == JsonValue.OBJECT) {
            JsonValue got = this.ctx.object().get(name);
            if (got != null) {
                return #Eval.copy(got);
            }
        }
        if (this.macroOf(name) >= 0) {
            return #this.makeHandle("__jinja_macro__", name);
        }
        if (Eval.isBuiltinCallable(name)) {
            return #this.makeHandle("__jinja_callable__", name);
        }
        this.lastUndef #= "" + name;
        return null;
    }

    static boolean isBuiltinCallable(String name) {
        return name.equals("range") || name.equals("dict")
            || name.equals("namespace") || name.equals("cycler")
            || name.equals("joiner") || name.equals("lipsum")
            || name.equals("strftime_now")
            || name.equals("raise_exception");
    }

    /** {"<marker>": name} — a copyable handle value. */
    #JsonValue makeHandle(String marker, String name) {
        JsonObject h = heap JsonObject();
        Eval.putKey(h, marker, Eval.str(name));
        JsonValue v = heap JsonValue();
        v.setObject(#h);
        return #v;
    }

    /** {"<marker>": id} — a registry-backed handle. */
    #JsonValue makeIdHandle(String marker, int32 id) {
        JsonObject h = heap JsonObject();
        Eval.putKey(h, marker, Eval.num((int64) id));
        JsonValue v = heap JsonValue();
        v.setObject(#h);
        return #v;
    }

    /** Markup: a SAFE string is {"__jinja_safe__": inner}. Safety is
     *  a property of the VALUE (composition applies even with
     *  autoescape off — oracle-verified); the environment flag only
     *  gates output escaping and block-output wrapping. */
    boolean isSafe(JsonValue v) {
        return v != null && v.kind() == JsonValue.OBJECT
            && v.object().containsKey("__jinja_safe__");
    }

    /** Borrow of the inner string value of a safe handle. */
    JsonValue safeInner(JsonValue v) {
        return v.object().get("__jinja_safe__");
    }

    #JsonValue wrapSafe(#JsonValue inner) {
        JsonObject h = heap JsonObject();
        Eval.putKey(h, "__jinja_safe__", #inner);
        JsonValue v = heap JsonValue();
        v.setObject(#h);
        return #v;
    }

    #JsonValue wrapSafeText(String s) {
        return #this.wrapSafe(Eval.str(s));
    }

    /** Registry id behind a handle, or -1. */
    int32 handleId(JsonValue v, String marker) {
        if (v == null || v.kind() != JsonValue.OBJECT) {
            return 0 - 1;
        }
        JsonValue idv = v.object().get(marker);
        if (idv == null || idv.kind() != JsonValue.NUMBER) {
            return 0 - 1;
        }
        return (int32) idv.asInt64();
    }

    /** Store an entry, return its id (namespaces, cyclers, joiners). */
    int32 registryAdd(#JsonValue entry) {
        if (this.nsN >= (int32) this.nsStore.count()) {
            JsonValue[] grown = heap JsonValue[this.nsN * 2];
            int32 g = 0;
            while (g < this.nsN) {
                grown[g] = this.nsStore[g];
                g = g + 1;
            }
            this.nsStore #= grown;
        }
        this.nsStore[this.nsN] #= entry;
        this.nsN = this.nsN + 1;
        return this.nsN - 1;
    }

    /** Replace-semantics write into a registry entry (JsonObject.put
     *  APPENDS by contract, so rebuild without the old binding). */
    void registryWrite(int32 id, String attr, #JsonValue v) {
        JsonObject old = this.nsStore[id].object();
        JsonObject fresh = heap JsonObject();
        int32 j = 0;
        while (j < old.count()) {
            String key #= Eval.keyOf(old, j);
            if (key.equals(attr) == false) {
                Eval.putKey(fresh, key, Eval.copy(old.valueAt(j)));
            }
            j = j + 1;
        }
        Eval.putKey(fresh, attr, #v);
        JsonValue nv = heap JsonValue();
        nv.setObject(#fresh);
        this.nsStore[id] #= nv;
    }

    // ── rendering ──────────────────────────────────────────────────────

    #String render() {
        this.runChain(this.nd.root);
        return #this.out.take();
    }

    /** Run a statement chain, stopping early when a break/continue
     *  signal is in flight (the enclosing for clears it). */
    void runChain(int32 head) {
        int32 i = head;
        while (i >= 0 && this.brk == false && this.cont == false) {
            this.exec(i);
            i = this.nd.nx(i);
        }
    }

    void exec(int32 i) {
        int32 k = this.nd.k(i);
        int32 line = this.nd.line(i);
        if (k == Node.N_TEXT) {
            this.out.addStr(this.nd.strOf(i));
            return;
        }
        if (k == Node.N_OUT) {
            JsonValue v #= this.eval(this.nd.a(i));
            String s #= this.text(v, line);
            if (this.autoescape && this.isSafe(v) == false) {
                String esc #= Filters.htmlEscape(s);
                this.out.addStr(esc);
            } else {
                this.out.addStr(s);
            }
            return;
        }
        if (k == Node.N_IF) {
            JsonValue c #= this.eval(this.nd.a(i));
            if (this.truthy(c, line)) {
                this.runChain(this.nd.b(i));
            } else if (this.nd.c(i) >= 0) {
                this.runChain(this.nd.c(i));
            }
            return;
        }
        if (k == Node.N_SET) {
            this.execSet(i);
            return;
        }
        if (k == Node.N_WITH) {
            this.execWith(i);
            return;
        }
        if (k == Node.N_FOR) {
            this.execFor(i);
            return;
        }
        if (k == Node.N_EXTENDS) {
            // Child statements execute (sets, macro defs) but their
            // OUTPUT is discarded; the parent chain renders.
            int32 mark = this.out.n;
            this.runChain(this.nd.a(i));
            this.out.n = mark;
            this.runChain(this.nd.b(i));
            return;
        }
        if (k == Node.N_INCLUDE) {
            // Included templates share the context but keep their own
            // scope (sets don't leak out — oracle-verified).
            if (this.nd.b(i) >= 0) {
                int32 mark2 = this.beginScope();
                this.runChain(this.nd.b(i));
                this.endScope(mark2);
            }
            return;
        }
        if (k == Node.N_BLOCK) {
            this.pushSuper(this.nd.c(i));
            this.runChain(this.nd.b(i));
            this.popSuper();
            return;
        }
        if (k == Node.N_MACRO) {
            this.addMacro(this.nd.strOf(i), i);
            return;
        }
        if (k == Node.N_CALLBLK) {
            // The E_CALL renders the macro with caller() available.
            int32 call = this.nd.a(i);
            JsonValue v #= this.evalCallWithCaller(call,
                this.nd.b(i), this.nd.c(i));
            String s #= this.text(v, line);
            this.out.addStr(s);
            return;
        }
        if (k == Node.N_FILTBLK) {
            int32 mark = this.out.n;
            this.runChain(this.nd.b(i));
            int32 m = this.out.n - mark;
            int8[] captured = heap int8[m];
            int32 z = 0;
            while (z < m) {
                captured[z] = this.out.b[mark + z];
                z = z + 1;
            }
            this.out.n = mark;
            JsonValue sv = heap JsonValue();
            sv.setStringOwned(#captured, m);
            JsonValue blk = null;
            if (this.autoescape) {
                blk #= this.wrapSafe(#sv);
            } else {
                blk #= sv;
            }
            JsonValue fv #= Filters.apply(this, this.nd.strOf(i), blk,
                this.nd.a(i), line);
            String t #= this.text(fv, line);
            if (this.autoescape && this.isSafe(fv) == false) {
                String esc #= Filters.htmlEscape(t);
                this.out.addStr(esc);
            } else {
                this.out.addStr(t);
            }
            return;
        }
        if (k == Node.N_BREAK) {
            this.brk = true;
            return;
        }
        if (k == Node.N_CONTINUE) {
            this.cont = true;
            return;
        }
        throw heap JinjaException("unhandled statement kind " + k
            + " at line " + line, line, 0);
    }

    void execSet(int32 i) {
        int32 line = this.nd.line(i);
        String target = this.nd.strOf(i);
        JsonValue v = null;
        if (this.nd.a(i) >= 0) {
            v #= this.eval(this.nd.a(i));
        } else {
            // Block form: capture the body's rendering as the value.
            int32 mark = this.out.n;
            this.runChain(this.nd.b(i));
            int32 m = this.out.n - mark;
            int8[] captured = heap int8[m];
            int32 z = 0;
            while (z < m) {
                captured[z] = this.out.b[mark + z];
                z = z + 1;
            }
            this.out.n = mark;
            JsonValue sv = heap JsonValue();
            sv.setStringOwned(#captured, m);
            if (this.autoescape) {
                v #= this.wrapSafe(#sv);
            } else {
                v #= sv;
            }
        }
        int32 dot = target.indexOf(".");
        if (dot < 0) {
            this.assign(target, #v);
            return;
        }
        // ns.attr — write through the namespace registry.
        String base #= target.substring(0, dot);
        String attr #= target.substring(dot + 1, target.byteLength());
        JsonValue h #= this.lookup(base);
        int32 id = this.nsIdOf(h);
        if (id < 0) {
            this.err("'" + base + "' is not a namespace; only "
                + "namespace attributes are assignable", line);
        }
        if (v == null) {
            v = heap JsonValue();
            v.setNull();
        }
        this.nsWrite(id, attr, #v);
    }

    /** Replace-semantics write into a namespace entry. JsonObject.put
     *  APPENDS (documented; a re-put key is unreachable via get), so
     *  the entry is rebuilt without the old binding. Entries are a
     *  handful of attrs; O(n) per write is nothing. */
    void nsWrite(int32 id, String attr, #JsonValue v) {
        this.registryWrite(id, attr, #v);
    }

    void execWith(int32 i) {
        // Assignments evaluate in the OUTER scope (oracle-verified:
        // `{% with a = 1, b = a + 1 %}` fails on `a`).
        int32 a = this.nd.a(i);
        int32 count = 0;
        int32 walk = a;
        while (walk >= 0) {
            count = count + 1;
            walk = this.nd.nx(walk);
        }
        JsonValue[] pending = heap JsonValue[count];
        int32 z = 0;
        walk = a;
        while (walk >= 0) {
            pending[z] #= this.eval(this.nd.a(walk));
            z = z + 1;
            walk = this.nd.nx(walk);
        }
        int32 mark = this.beginScope();
        z = 0;
        walk = a;
        while (walk >= 0) {
            JsonValue pv #= pending[z];
            if (pv == null) {
                pv = heap JsonValue();
                pv.setNull();
            }
            this.push(this.nd.strOf(walk), #pv);
            z = z + 1;
            walk = this.nd.nx(walk);
        }
        this.runChain(this.nd.b(i));
        this.endScope(mark);
    }

    void execFor(int32 i) {
        int32 line = this.nd.line(i);
        JsonValue seq #= this.eval(this.nd.a(i));
        JsonArray items #= this.materialize(seq, line);

        // Split the name list once per execution.
        String spec = this.nd.strOf(i);
        int32 nameCount = this.nd.d(i);
        String[] nm = heap String[nameCount];
        int32 from = 0;
        int32 ni = 0;
        int32 sn = spec.byteLength();
        int32 sx = 0;
        while (sx <= sn) {
            if (sx == sn || spec.byteAt(sx) == 44) {
                nm[ni] #= spec.substring(from, sx);
                ni = ni + 1;
                from = sx + 1;
            }
            sx = sx + 1;
        }

        // Loop filter: evaluated with the loop variables bound but no
        // `loop` object, over the RAW items; loop.* sees the filtered
        // sequence.
        int32 filter = this.nd.e(i);
        if (filter >= 0) {
            JsonArray kept = heap JsonArray();
            int32 fi = 0;
            while (fi < items.count()) {
                int32 fmark = this.beginScope();
                this.bindNames(nm, nameCount, items.get(fi), line);
                JsonValue fv #= this.eval(filter);
                boolean keep = this.truthy(fv, line);
                this.endScope(fmark);
                if (keep) {
                    kept.add(Eval.copy(items.get(fi)));
                }
                fi = fi + 1;
            }
            items #= kept;
        }

        int32 n = items.count();
        // for/else runs iff NO iteration ran the body to COMPLETION —
        // break AND continue both skip the flag (Jinja's codegen, not
        // Python's for/else; oracle-verified).
        boolean completed = false;
        int32 x = 0;
        while (x < n) {
            int32 mark = this.beginScope();
            this.bindNames(nm, nameCount, items.get(x), line);
            this.push("loop", #this.loopObject(items, x, n));
            this.runChain(this.nd.b(i));
            this.endScope(mark);
            if (this.cont) {
                this.cont = false;
                x = x + 1;
                continue;
            }
            if (this.brk) {
                this.brk = false;
                break;
            }
            completed = true;
            x = x + 1;
        }
        if (completed == false && this.nd.c(i) >= 0) {
            // The else arm is its own scope (a `set` there does not
            // leak — oracle-verified), with no `loop` object.
            int32 emark = this.beginScope();
            this.runChain(this.nd.c(i));
            this.endScope(emark);
        }
    }

    /** Iterable -> owned item array. Arrays give elements, mappings
     *  their keys, strings their (byte) characters; undefined iterates
     *  EMPTY in default mode (oracle-verified) and raises in strict;
     *  everything else is an error, as in Jinja. */
    #JsonArray materialize(JsonValue seq, int32 line) {
        JsonArray items = heap JsonArray();
        if (seq == null) {
            if (this.strict) {
                this.undefErr(line);
            }
            return #items;
        }
        int32 k = seq.kind();
        if (k == JsonValue.ARRAY) {
            JsonArray src = seq.array();
            int32 i = 0;
            while (i < src.count()) {
                items.add(Eval.copy(src.get(i)));
                i = i + 1;
            }
            return #items;
        }
        if (k == JsonValue.OBJECT) {
            JsonObject o = seq.object();
            int32 j = 0;
            while (j < o.count()) {
                String key #= Eval.keyOf(o, j);
                items.add(Eval.str(key));
                j = j + 1;
            }
            return #items;
        }
        if (k == JsonValue.STRING) {
            int8[] sb = seq.asBytes();
            int32 n = seq.asBytesLength();
            int32 i = 0;
            while (i < n) {
                int8[] one = heap int8[1];
                one[0] = sb[i];
                JsonValue cv = heap JsonValue();
                cv.setStringOwned(#one, 1);
                items.add(#cv);
                i = i + 1;
            }
            return #items;
        }
        this.err("value is not iterable", line);
        return #items;                       // unreachable
    }

    /** Bind the loop variable(s) for one item, unpacking when the
     *  target list has several names. */
    void bindNames(String[] nm, int32 count, JsonValue item,
            int32 line) {
        if (count == 1) {
            this.push(nm[0], #Eval.copy(item));
            return;
        }
        if (item == null || item.kind() != JsonValue.ARRAY
                || item.array().count() != count) {
            this.err("cannot unpack loop item into " + count
                + " names", line);
        }
        JsonArray ia = item.array();
        int32 j = 0;
        while (j < count) {
            this.push(nm[j], #Eval.copy(ia.get(j)));
            j = j + 1;
        }
    }

    /** The `loop` object for one iteration (spec 2.4): previtem and
     *  nextitem are ABSENT keys at the edges, which member() turns
     *  into undefined — exactly Jinja. `__jinja_loop__` marks it so
     *  cycle() can find index0. */
    #JsonValue loopObject(JsonArray items, int32 x, int32 n) {
        JsonObject o = heap JsonObject();
        Eval.putKey(o, "__jinja_loop__", Eval.bool(true));
        Eval.putKey(o, "index", Eval.num((int64) x + 1));
        Eval.putKey(o, "index0", Eval.num((int64) x));
        Eval.putKey(o, "revindex", Eval.num((int64) (n - x)));
        Eval.putKey(o, "revindex0", Eval.num((int64) (n - x - 1)));
        Eval.putKey(o, "first", Eval.bool(x == 0));
        Eval.putKey(o, "last", Eval.bool(x == n - 1));
        Eval.putKey(o, "length", Eval.num((int64) n));
        if (x > 0) {
            Eval.putKey(o, "previtem", Eval.copy(items.get(x - 1)));
        }
        if (x < n - 1) {
            Eval.putKey(o, "nextitem", Eval.copy(items.get(x + 1)));
        }
        JsonValue v = heap JsonValue();
        v.setObject(#o);
        return #v;
    }

    /** Namespace-handle id, or -1 when the value is not one. */
    int32 nsIdOf(JsonValue v) {
        return this.handleId(v, "__jinja_ns__");
    }

    // ── errors ─────────────────────────────────────────────────────────

    void undefErr(int32 line) {
        throw heap JinjaException("'" + this.lastUndef
            + "' is undefined (line " + line + ")", line, 0);
    }

    void err(String msg, int32 line) {
        throw heap JinjaException(msg + " (line " + line + ")", line, 0);
    }

    // ── value constructors (owned bytes, always) ───────────────────────

    static #JsonValue str(String s) {
        JsonValue v = heap JsonValue();
        int8[] w #= s.toBytes();
        v.setStringOwned(#w, s.byteLength());
        return #v;
    }

    static #JsonValue num(int64 n) {
        JsonValue v = heap JsonValue();
        v.setNumber(n);
        return #v;
    }

    static #JsonValue flt(float64 f) {
        JsonValue v = heap JsonValue();
        v.setFloat(f);
        return #v;
    }

    static #JsonValue bool(boolean b) {
        JsonValue v = heap JsonValue();
        v.setBoolean(b);
        return #v;
    }

    static #JsonValue copy(JsonValue v) {
        JsonValue r = heap JsonValue();
        if (v == null) {
            r.setNull();
            return #r;
        }
        int32 k = v.kind();
        if (k == JsonValue.NULL) {
            r.setNull();
        } else if (k == JsonValue.BOOLEAN) {
            r.setBoolean(v.asBoolean());
        } else if (k == JsonValue.NUMBER) {
            if (v.isFloat()) {
                r.setFloat(v.asFloat64());
            } else {
                r.setNumber(v.asInt64());
            }
        } else if (k == JsonValue.STRING) {
            int32 sn = v.asBytesLength();
            int8[] sb = v.asBytes();
            int8[] dst = heap int8[sn];
            int32 z = 0;
            while (z < sn) {
                dst[z] = sb[z];
                z = z + 1;
            }
            r.setStringOwned(#dst, sn);
        } else if (k == JsonValue.ARRAY) {
            JsonArray src = v.array();
            JsonArray dst = heap JsonArray();
            int32 i = 0;
            while (i < src.count()) {
                dst.add(Eval.copy(src.get(i)));
                i = i + 1;
            }
            r.setArray(#dst);
        } else {
            JsonObject src2 = v.object();
            JsonObject dst2 = heap JsonObject();
            int32 j = 0;
            while (j < src2.count()) {
                int8[] kb = src2.keyAt(j);
                int32 kl = src2.keyLenAt(j);
                int8[] kc = heap int8[kl];
                int32 z2 = 0;
                while (z2 < kl) {
                    kc[z2] = kb[z2];
                    z2 = z2 + 1;
                }
                dst2.put(#kc, kl, Eval.copy(src2.valueAt(j)));
                j = j + 1;
            }
            r.setObject(#dst2);
        }
        return #r;
    }

    static #String keyOf(JsonObject o, int32 j) {
        int32 kl = o.keyLenAt(j);
        int8[] src = o.keyAt(j);
        int8[] dst = heap int8[kl];
        int32 i = 0;
        while (i < kl) {
            dst[i] = src[i];
            i = i + 1;
        }
        return heap String(#dst, kl);
    }

    static void putKey(JsonObject o, String key, #JsonValue v) {
        int32 n = key.byteLength();
        int8[] kb = heap int8[n];
        int32 i = 0;
        while (i < n) {
            kb[i] = (int8) key.byteAt(i);
            i = i + 1;
        }
        o.put(#kb, n, #v);
    }

    // ── value semantics ────────────────────────────────────────────────

    boolean truthy(JsonValue v, int32 line) {
        if (v == null) {
            if (this.strict) {
                this.undefErr(line);
            }
            return false;
        }
        int32 k = v.kind();
        if (k == JsonValue.NULL) {
            return false;
        }
        if (k == JsonValue.BOOLEAN) {
            return v.asBoolean();
        }
        if (k == JsonValue.NUMBER) {
            if (v.isFloat()) {
                return v.asFloat64() != 0.0;
            }
            return v.asInt64() != 0;
        }
        if (k == JsonValue.STRING) {
            return v.asBytesLength() > 0;
        }
        if (k == JsonValue.ARRAY) {
            return v.array().count() > 0;
        }
        return v.object().count() > 0;
    }

    static boolean isNumberish(JsonValue v) {
        return v != null && (v.kind() == JsonValue.NUMBER
            || v.kind() == JsonValue.BOOLEAN);
    }

    static boolean isFloaty(JsonValue v) {
        return v.kind() == JsonValue.NUMBER && v.isFloat();
    }

    static int64 toI64(JsonValue v) {
        if (v.kind() == JsonValue.BOOLEAN) {
            if (v.asBoolean()) {
                return 1;
            }
            return 0;
        }
        return v.asInt64();
    }

    static float64 toF64(JsonValue v) {
        if (v.kind() == JsonValue.BOOLEAN) {
            if (v.asBoolean()) {
                return 1.0;
            }
            return 0.0;
        }
        return v.asFloat64();
    }

    /** Jinja's `str()` for interpolation. */
    #String text(JsonValue v, int32 line) {
        if (this.isSafe(v)) {
            return #this.text(this.safeInner(v), line);
        }
        if (v == null) {
            if (this.strict) {
                this.undefErr(line);
            }
            return "";
        }
        int32 k = v.kind();
        if (k == JsonValue.NULL) {
            return "None";
        }
        if (k == JsonValue.BOOLEAN) {
            if (v.asBoolean()) {
                return "True";
            }
            return "False";
        }
        if (k == JsonValue.NUMBER) {
            if (v.isFloat()) {
                return #Eval.fmtFloat(v.asFloat64());
            }
            return "" + v.asInt64();
        }
        if (k == JsonValue.STRING) {
            return "" + v.asString();
        }
        Buf b = heap Buf();
        Eval.pyRepr(b, v);
        return #b.take();
    }

    /**
     * Python repr of a float, exact for integral and dyadic values
     * (see the class doc): "2.0", "3.5", "0.25". The digit loop is
     * exact float arithmetic while the value terminates in binary,
     * which is precisely when CPython's shortest repr equals the plain
     * expansion.
     */
    static #String fmtFloat(float64 v) {
        if (v != v) {
            return "nan";
        }
        if (v < 0.0) {
            return "-" + Eval.fmtFloat(0.0 - v);
        }
        if (v > 1.5e308 && v * 0.5 == v) {
            return "inf";
        }
        float64 ip = Math.floor(v);
        if (ip == v && v < 9.0e15) {
            return "" + (int64) v + ".0";
        }
        int64 whole = (int64) ip;
        float64 frac = v - ip;
        Buf b = heap Buf();
        b.addStr("" + whole);
        b.addByte(46);                       // '.'
        int32 guard = 0;
        while (guard < 17) {
            frac = frac * 10.0;
            int32 d = (int32) Math.floor(frac);
            frac = frac - Math.floor(frac);
            b.addByte(48 + d);
            if (frac == 0.0) {
                guard = 17;
            } else {
                guard = guard + 1;
            }
        }
        return #b.take();
    }

    /** Python repr — what Jinja prints for lists and dicts:
     *  single-quoted strings, True/False/None, `[1, 'x']`,
     *  `{'k': 1}`. */
    static void pyRepr(Buf b, JsonValue v) {
        if (v == null) {
            b.addStr("Undefined");
            return;
        }
        int32 k = v.kind();
        if (k == JsonValue.NULL) {
            b.addStr("None");
            return;
        }
        if (k == JsonValue.BOOLEAN) {
            if (v.asBoolean()) {
                b.addStr("True");
            } else {
                b.addStr("False");
            }
            return;
        }
        if (k == JsonValue.NUMBER) {
            if (v.isFloat()) {
                String f #= Eval.fmtFloat(v.asFloat64());
                b.addStr(f);
            } else {
                b.addStr("" + v.asInt64());
            }
            return;
        }
        if (k == JsonValue.STRING) {
            Eval.pyReprStr(b, v);
            return;
        }
        if (k == JsonValue.ARRAY) {
            JsonArray a = v.array();
            b.addByte(91);                   // '['
            int32 i = 0;
            while (i < a.count()) {
                if (i > 0) {
                    b.addStr(", ");
                }
                Eval.pyRepr(b, a.get(i));
                i = i + 1;
            }
            b.addByte(93);                   // ']'
            return;
        }
        JsonObject o = v.object();
        b.addByte(123);                      // '{'
        int32 j = 0;
        while (j < o.count()) {
            if (j > 0) {
                b.addStr(", ");
            }
            String key #= Eval.keyOf(o, j);
            JsonValue kv #= Eval.str(key);
            Eval.pyReprStr(b, kv);
            b.addStr(": ");
            Eval.pyRepr(b, o.valueAt(j));
            j = j + 1;
        }
        b.addByte(125);                      // '}'
    }

    /** Python string repr: prefer single quotes; switch to double when
     *  the value contains a `'` but no `"`. */
    static void pyReprStr(Buf b, JsonValue v) {
        int8[] s = v.asBytes();
        int32 n = v.asBytesLength();
        boolean hasSingle = false;
        boolean hasDouble = false;
        int32 i = 0;
        while (i < n) {
            int32 c = ((int32) s[i]) & 255;
            if (c == 39) { hasSingle = true; }
            if (c == 34) { hasDouble = true; }
            i = i + 1;
        }
        int32 quote = 39;                    // '\''
        if (hasSingle && hasDouble == false) {
            quote = 34;                      // '"'
        }
        b.addByte(quote);
        i = 0;
        while (i < n) {
            int32 c = ((int32) s[i]) & 255;
            if (c == 92 || c == quote) {
                b.addByte(92);
                b.addByte(c);
            } else if (c == 10) {
                b.addByte(92);
                b.addByte(110);              // \n
            } else if (c == 13) {
                b.addByte(92);
                b.addByte(114);              // \r
            } else if (c == 9) {
                b.addByte(92);
                b.addByte(116);              // \t
            } else {
                b.addByte(c);
            }
            i = i + 1;
        }
        b.addByte(quote);
    }

    /** Python `==`: bools count as 0/1 against numbers, strings only
     *  equal strings, containers compare deep; undefined equals only
     *  undefined (Jinja's Undefined.__eq__ compares type). */
    boolean eq(JsonValue a, JsonValue b, int32 line) {
        if (a == null || b == null) {
            if (this.strict) {
                this.undefErr(line);         // StrictUndefined.__eq__
            }
            return a == null && b == null;
        }
        int32 ka = a.kind();
        int32 kb = b.kind();
        if (ka == JsonValue.NULL || kb == JsonValue.NULL) {
            return ka == kb;
        }
        if (Eval.isNumberish(a) && Eval.isNumberish(b)) {
            if (Eval.isFloaty(a) || Eval.isFloaty(b)) {
                return Eval.toF64(a) == Eval.toF64(b);
            }
            return Eval.toI64(a) == Eval.toI64(b);
        }
        if (ka != kb) {
            return false;
        }
        if (ka == JsonValue.STRING) {
            return a.asString().equals(b.asString());
        }
        if (ka == JsonValue.ARRAY) {
            JsonArray aa = a.array();
            JsonArray ba = b.array();
            if (aa.count() != ba.count()) {
                return false;
            }
            int32 i = 0;
            while (i < aa.count()) {
                if (this.eq(aa.get(i), ba.get(i), line) == false) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        JsonObject ao = a.object();
        JsonObject bo = b.object();
        if (ao.count() != bo.count()) {
            return false;
        }
        int32 j = 0;
        while (j < ao.count()) {
            String key #= Eval.keyOf(ao, j);
            JsonValue bv = bo.get(key);
            if (bv == null) {
                return false;
            }
            if (this.eq(ao.valueAt(j), bv, line) == false) {
                return false;
            }
            j = j + 1;
        }
        return true;
    }

    /** Ordering: numbers (bools as 0/1) and strings; anything else —
     *  undefined included — raises, as Jinja does. */
    int32 ordCmp(JsonValue a, JsonValue b, int32 line) {
        if (a == null || b == null) {
            this.undefErr(line);
        }
        if (Eval.isNumberish(a) && Eval.isNumberish(b)) {
            if (Eval.isFloaty(a) || Eval.isFloaty(b)) {
                float64 x = Eval.toF64(a);
                float64 y = Eval.toF64(b);
                if (x < y) { return 0 - 1; }
                if (x > y) { return 1; }
                return 0;
            }
            int64 xi = Eval.toI64(a);
            int64 yi = Eval.toI64(b);
            if (xi < yi) { return 0 - 1; }
            if (xi > yi) { return 1; }
            return 0;
        }
        if (a.kind() == JsonValue.STRING && b.kind() == JsonValue.STRING) {
            int8[] sa = a.asBytes();
            int8[] sb = b.asBytes();
            int32 na = a.asBytesLength();
            int32 nb = b.asBytesLength();
            int32 i = 0;
            while (i < na && i < nb) {
                int32 ca = ((int32) sa[i]) & 255;
                int32 cb = ((int32) sb[i]) & 255;
                if (ca < cb) { return 0 - 1; }
                if (ca > cb) { return 1; }
                i = i + 1;
            }
            if (na < nb) { return 0 - 1; }
            if (na > nb) { return 1; }
            return 0;
        }
        this.err("unorderable operand types in a comparison", line);
        return 0;                            // unreachable
    }

    boolean contains(JsonValue haystack, JsonValue needle, int32 line) {
        if (haystack == null) {
            if (this.strict) {
                this.undefErr(line);
            }
            return false;
        }
        if (haystack.kind() == JsonValue.ARRAY) {
            JsonArray a = haystack.array();
            int32 i = 0;
            while (i < a.count()) {
                if (this.eqLenient(a.get(i), needle, line)) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        if (haystack.kind() == JsonValue.OBJECT) {
            if (needle == null) {
                return false;
            }
            String key #= this.text(needle, line);
            return haystack.object().containsKey(key);
        }
        if (haystack.kind() == JsonValue.STRING) {
            if (needle == null) {
                return false;
            }
            String sub #= this.text(needle, line);
            return haystack.asString().contains(sub);
        }
        this.err("'in' needs a string, sequence, or mapping", line);
        return false;                        // unreachable
    }

    /** eq without the strict-undefined trip — membership scans compare
     *  against undefined needles legitimately. */
    boolean eqLenient(JsonValue a, JsonValue b, int32 line) {
        if (a == null || b == null) {
            return a == null && b == null;
        }
        return this.eq(a, b, line);
    }

    // ── expression evaluation ──────────────────────────────────────────

    #JsonValue eval(int32 i) {
        if (i < 0) {
            return null;
        }
        int32 k = this.nd.k(i);
        int32 line = this.nd.line(i);
        if (k == Node.E_STR) {
            return #Eval.str(this.nd.strOf(i));
        }
        if (k == Node.E_NUM) {
            String raw = this.nd.strOf(i);
            if (this.nd.d(i) == 1) {
                return #Eval.flt(Eval.parseFloat(raw));
            }
            return #Eval.num(Eval.parseInt(raw));
        }
        if (k == Node.E_TRUE) {
            return #Eval.bool(true);
        }
        if (k == Node.E_FALSE) {
            return #Eval.bool(false);
        }
        if (k == Node.E_NONE) {
            JsonValue v = heap JsonValue();
            v.setNull();
            return #v;
        }
        if (k == Node.E_NAME) {
            return #this.lookup(this.nd.strOf(i));
        }
        if (k == Node.E_ATTR) {
            JsonValue o #= this.eval(this.nd.a(i));
            if (o == null) {
                this.undefErr(line);         // raises in BOTH modes
            }
            return #this.member(o, this.nd.strOf(i));
        }
        if (k == Node.E_INDEX) {
            JsonValue o #= this.eval(this.nd.a(i));
            if (o == null) {
                this.undefErr(line);
            }
            JsonValue idx #= this.eval(this.nd.b(i));
            return #this.indexOf(o, idx, line);
        }
        if (k == Node.E_SLICE) {
            return #this.evalSlice(i);
        }
        if (k == Node.E_NOT) {
            JsonValue v #= this.eval(this.nd.a(i));
            return #Eval.bool(this.truthy(v, line) == false);
        }
        if (k == Node.E_NEG || k == Node.E_POS) {
            JsonValue v #= this.eval(this.nd.a(i));
            if (v == null) {
                this.undefErr(line);
            }
            if (Eval.isNumberish(v) == false) {
                this.err("unary +/- needs a number", line);
            }
            if (k == Node.E_POS) {
                return #Eval.copy(v);
            }
            if (Eval.isFloaty(v)) {
                return #Eval.flt(0.0 - v.asFloat64());
            }
            return #Eval.num(0 - Eval.toI64(v));
        }
        if (k == Node.E_COND) {
            JsonValue c #= this.eval(this.nd.a(i));
            if (this.truthy(c, line)) {
                return #this.eval(this.nd.b(i));
            }
            return #this.eval(this.nd.c(i));
        }
        if (k == Node.E_BIN) {
            return #this.evalBin(i);
        }
        if (k == Node.E_CMP) {
            return #this.evalCmp(i);
        }
        if (k == Node.E_TEST) {
            return #this.evalTest(i);
        }
        if (k == Node.E_FILTER) {
            JsonValue fv #= this.eval(this.nd.a(i));
            return #Filters.apply(this, this.nd.strOf(i), fv,
                this.nd.b(i), line);
        }
        if (k == Node.E_LIST) {
            JsonArray arr = heap JsonArray();
            int32 it = this.nd.a(i);
            while (it >= 0) {
                JsonValue item #= this.eval(it);
                if (item == null) {
                    item = heap JsonValue();
                    item.setNull();
                }
                arr.add(#item);
                it = this.nd.nx(it);
            }
            JsonValue v = heap JsonValue();
            v.setArray(#arr);
            return #v;
        }
        if (k == Node.E_DICT) {
            JsonObject o = heap JsonObject();
            int32 p = this.nd.a(i);
            while (p >= 0) {
                JsonValue key #= this.eval(this.nd.a(p));
                String kt #= this.text(key, line);
                JsonValue val #= this.eval(this.nd.b(p));
                if (val == null) {
                    val = heap JsonValue();
                    val.setNull();
                }
                Eval.putKey(o, kt, #val);
                p = this.nd.nx(p);
            }
            JsonValue v = heap JsonValue();
            v.setObject(#o);
            return #v;
        }
        if (k == Node.E_CALL) {
            return #this.evalCall(i);
        }
        throw heap JinjaException("unhandled expression kind " + k
            + " at line " + line, line, 0);
    }

    static int64 parseInt(String s) {
        int64 r = 0;
        int32 i = 0;
        int32 n = s.byteLength();
        while (i < n) {
            int32 c = s.byteAt(i);
            if (c >= 48 && c <= 57) {
                r = r * 10 + (int64) (c - 48);
            }
            i = i + 1;
        }
        return r;
    }

    /** Literal text -> float64: scaled-integer / power-of-ten, a single
     *  correctly-rounded division for every literal the corpus holds. */
    static float64 parseFloat(String s) {
        int64 digits = 0;
        int32 fracLen = 0;
        boolean seenDot = false;
        int32 i = 0;
        int32 n = s.byteLength();
        while (i < n) {
            int32 c = s.byteAt(i);
            if (c == 46) {
                seenDot = true;
            } else if (c >= 48 && c <= 57) {
                if (digits < 922337203685477579) {
                    digits = digits * 10 + (int64) (c - 48);
                    if (seenDot) {
                        fracLen = fracLen + 1;
                    }
                }
            }
            i = i + 1;
        }
        float64 scale = 1.0;
        int32 j = 0;
        while (j < fracLen) {
            scale = scale * 10.0;
            j = j + 1;
        }
        return ((float64) digits) / scale;
    }

    /** E_BIN: `and`/`or` short-circuit and return the OPERAND (Jinja
     *  keeps Python's value-returning logic ops); the rest are the
     *  arithmetic/concat table. */
    #JsonValue evalBin(int32 i) {
        String op = this.nd.strOf(i);
        int32 line = this.nd.line(i);
        if (op.equals("and")) {
            JsonValue l #= this.eval(this.nd.a(i));
            if (this.truthy(l, line) == false) {
                return #= l;
            }
            return #this.eval(this.nd.b(i));
        }
        if (op.equals("or")) {
            JsonValue l2 #= this.eval(this.nd.a(i));
            if (this.truthy(l2, line)) {
                return #= l2;
            }
            return #this.eval(this.nd.b(i));
        }
        JsonValue l3 #= this.eval(this.nd.a(i));
        JsonValue r #= this.eval(this.nd.b(i));
        if (op.equals("~")) {
            // `~` is the ENVIRONMENT's concat: Markup composition only
            // under autoescape (markup_join vs str_join — oracle-
            // verified). `+` below stays value-level (Python Markup).
            if (this.autoescape
                    && (this.isSafe(l3) || this.isSafe(r))) {
                String ls #= this.sideText(l3, line);
                String rs #= this.sideText(r, line);
                return #this.wrapSafeText(ls + rs);
            }
            String ls2 #= this.text(l3, line);
            String rs2 #= this.text(r, line);
            return #Eval.str(ls2 + rs2);
        }
        // Arithmetic below: undefined raises in BOTH modes.
        if (l3 == null || r == null) {
            this.undefErr(line);
        }
        if (op.equals("+")) {
            if (this.isSafe(l3) || this.isSafe(r)) {
                boolean bothStringy =
                    (this.isSafe(l3) || l3.kind() == JsonValue.STRING)
                    && (this.isSafe(r) || r.kind() == JsonValue.STRING);
                if (bothStringy) {
                    String ls #= this.sideText(l3, line);
                    String rs #= this.sideText(r, line);
                    return #this.wrapSafeText(ls + rs);
                }
            }
            if (l3.kind() == JsonValue.STRING
                    && r.kind() == JsonValue.STRING) {
                return #Eval.str(l3.asString() + r.asString());
            }
            if (l3.kind() == JsonValue.ARRAY
                    && r.kind() == JsonValue.ARRAY) {
                JsonArray dst = heap JsonArray();
                JsonArray la = l3.array();
                int32 z = 0;
                while (z < la.count()) {
                    dst.add(Eval.copy(la.get(z)));
                    z = z + 1;
                }
                JsonArray ra = r.array();
                z = 0;
                while (z < ra.count()) {
                    dst.add(Eval.copy(ra.get(z)));
                    z = z + 1;
                }
                JsonValue v = heap JsonValue();
                v.setArray(#dst);
                return #v;
            }
            return #this.arith(op, l3, r, line);
        }
        if (op.equals("*")) {
            // str * int and list * int repeat, as in Python.
            JsonValue seq = null;
            JsonValue cnt = null;
            if (l3.kind() == JsonValue.STRING
                    || l3.kind() == JsonValue.ARRAY) {
                seq = l3;
                cnt = r;
            } else if (r.kind() == JsonValue.STRING
                    || r.kind() == JsonValue.ARRAY) {
                seq = r;
                cnt = l3;
            }
            if (seq != null) {
                if (Eval.isNumberish(cnt) == false
                        || Eval.isFloaty(cnt)) {
                    this.err("sequence repetition needs an integer",
                        line);
                }
                int64 times = Eval.toI64(cnt);
                if (seq.kind() == JsonValue.STRING) {
                    Buf b = heap Buf();
                    int64 t = 0;
                    while (t < times) {
                        b.addStr(seq.asString());
                        t = t + 1;
                    }
                    return #Eval.str(b.take());
                }
                JsonArray dst2 = heap JsonArray();
                int64 t2 = 0;
                while (t2 < times) {
                    JsonArray sa = seq.array();
                    int32 z2 = 0;
                    while (z2 < sa.count()) {
                        dst2.add(Eval.copy(sa.get(z2)));
                        z2 = z2 + 1;
                    }
                    t2 = t2 + 1;
                }
                JsonValue v2 = heap JsonValue();
                v2.setArray(#dst2);
                return #v2;
            }
            return #this.arith(op, l3, r, line);
        }
        return #this.arith(op, l3, r, line);
    }

    /** The numeric table: `-`, the numeric halves of `+`/`*`, `/`
     *  (always float), `//` (floors), `%` (divisor's sign), `**`
     *  (int result only for int bases with non-negative exponents). */
    #JsonValue arith(String op, JsonValue l, JsonValue r, int32 line) {
        if (Eval.isNumberish(l) == false
                || Eval.isNumberish(r) == false) {
            this.err("unsupported operand types for '" + op + "'", line);
        }
        boolean f = Eval.isFloaty(l) || Eval.isFloaty(r);
        if (op.equals("/")) {
            float64 d = Eval.toF64(r);
            if (d == 0.0) {
                this.err("division by zero", line);
            }
            return #Eval.flt(Eval.toF64(l) / d);
        }
        if (op.equals("//")) {
            if (f) {
                float64 d2 = Eval.toF64(r);
                if (d2 == 0.0) {
                    this.err("division by zero", line);
                }
                return #Eval.flt(Math.floor(Eval.toF64(l) / d2));
            }
            int64 b = Eval.toI64(r);
            if (b == 0) {
                this.err("division by zero", line);
            }
            int64 a = Eval.toI64(l);
            int64 q = a / b;
            if (a % b != 0 && ((a < 0) != (b < 0))) {
                q = q - 1;
            }
            return #Eval.num(q);
        }
        if (op.equals("%")) {
            if (f) {
                float64 d3 = Eval.toF64(r);
                if (d3 == 0.0) {
                    this.err("modulo by zero", line);
                }
                float64 a3 = Eval.toF64(l);
                return #Eval.flt(a3 - Math.floor(a3 / d3) * d3);
            }
            int64 b2 = Eval.toI64(r);
            if (b2 == 0) {
                this.err("modulo by zero", line);
            }
            int64 a2 = Eval.toI64(l);
            int64 m = a2 % b2;
            if (m != 0 && ((m < 0) != (b2 < 0))) {
                m = m + b2;
            }
            return #Eval.num(m);
        }
        if (op.equals("**")) {
            if (f == false) {
                int64 e = Eval.toI64(r);
                if (e >= 0) {
                    int64 base = Eval.toI64(l);
                    int64 acc = 1;
                    int64 z = 0;
                    while (z < e) {
                        // int64 overflow TRAPS in cajeta — guard with a
                        // float shadow before multiplying.
                        float64 shadow = (float64) acc * (float64) base;
                        if (shadow > 9.0e18 || shadow < 0.0 - 9.0e18) {
                            this.err("integer overflow in '**'", line);
                        }
                        acc = acc * base;
                        z = z + 1;
                    }
                    return #Eval.num(acc);
                }
                return #Eval.flt(Math.pow(Eval.toF64(l), Eval.toF64(r)));
            }
            return #Eval.flt(Math.pow(Eval.toF64(l), Eval.toF64(r)));
        }
        if (f) {
            float64 x = Eval.toF64(l);
            float64 y = Eval.toF64(r);
            if (op.equals("+")) {
                return #Eval.flt(x + y);
            }
            if (op.equals("-")) {
                return #Eval.flt(x - y);
            }
            return #Eval.flt(x * y);         // "*"
        }
        int64 xi = Eval.toI64(l);
        int64 yi = Eval.toI64(r);
        if (op.equals("+")) {
            return #Eval.num(xi + yi);
        }
        if (op.equals("-")) {
            return #Eval.num(xi - yi);
        }
        return #Eval.num(xi * yi);           // "*"
    }

    /** One side of a Markup composition: safe -> raw inner text,
     *  unsafe -> escaped text. */
    #String sideText(JsonValue v, int32 line) {
        if (this.isSafe(v)) {
            return #this.text(v, line);
        }
        String t #= this.text(v, line);
        return #Filters.htmlEscape(t);
    }

    /** Chained comparison: every operand evaluated once, pairwise ops
     *  ANDed, first failure wins. */
    #JsonValue evalCmp(int32 i) {
        JsonValue cur #= this.eval(this.nd.a(i));
        int32 op = this.nd.b(i);
        while (op >= 0) {
            int32 line = this.nd.line(op);
            JsonValue rhs #= this.eval(this.nd.a(op));
            String o = this.nd.strOf(op);
            boolean ok = false;
            if (o.equals("==")) {
                ok = this.eq(cur, rhs, line);
            } else if (o.equals("!=")) {
                ok = this.eq(cur, rhs, line) == false;
            } else if (o.equals("in")) {
                ok = this.contains(rhs, cur, line);
            } else if (o.equals("notin")) {
                ok = this.contains(rhs, cur, line) == false;
            } else {
                int32 c = this.ordCmp(cur, rhs, line);
                if (o.equals("<")) {
                    ok = c < 0;
                } else if (o.equals("<=")) {
                    ok = c <= 0;
                } else if (o.equals(">")) {
                    ok = c > 0;
                } else {
                    ok = c >= 0;             // ">="
                }
            }
            if (ok == false) {
                return #Eval.bool(false);
            }
            cur #= rhs;
            op = this.nd.nx(op);
        }
        return #Eval.bool(true);
    }

    #JsonValue member(JsonValue o, String name) {
        if (o != null && o.kind() == JsonValue.OBJECT
                && name.equals("name")) {
