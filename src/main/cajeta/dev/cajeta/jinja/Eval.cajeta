                JsonObject entry = heap JsonObject();
                JsonValue iv = heap JsonValue();
                iv.setArray(#items);
                Eval.putKey(entry, "items", #iv);
                Eval.putKey(entry, "pos", Eval.num((int64) 0));
                JsonValue ev2 = heap JsonValue();
                ev2.setObject(#entry);
                int32 id = this.registryAdd(#ev2);
                return #this.makeIdHandle("__jinja_cycler__", id);
            }
            if (fn.equals("joiner")) {
                String sep = ", ";
                if (args >= 0) {
                    String s2 #= this.argText(args, line);
                    sep = "" + s2;
                }
                JsonObject entry = heap JsonObject();
                Eval.putKey(entry, "sep", Eval.str(sep));
                Eval.putKey(entry, "used", Eval.bool(false));
                JsonValue ev3 = heap JsonValue();
                ev3.setObject(#entry);
                int32 id2 = this.registryAdd(#ev3);
                return #this.makeIdHandle("__jinja_joiner__", id2);
            }
            if (fn.equals("raise_exception")) {
                String msg = "";
                if (args >= 0) {
                    String m2 #= this.argText(args, line);
                    msg = "" + m2;
                }
                throw heap JinjaException(msg + " (line " + line + ")",
                    line, 0);
            }
            if (fn.equals("strftime_now")) {
                if (this.nowEpoch == 0) {
                    this.err("strftime_now: no clock was injected "
                        + "(Environment.nowEpochSeconds)", line);
                }
                if (args < 0) {
                    this.err("strftime_now needs a format string", line);
                }
                String f #= this.argText(args, line);
                return #Eval.str(Strftime.format(f, this.nowEpoch));
            }
            if (fn.equals("lipsum")) {
                return #this.lipsum(args, line);
            }
        }
        if (ck != Node.E_ATTR) {
            // General callee: a VALUE that is itself callable — a
            // joiner, or a builtin bound to a variable.
            JsonValue cv #= this.eval(callee);
            if (cv != null && cv.kind() == JsonValue.OBJECT) {
                JsonValue mh = cv.object().get("__jinja_macro__");
                if (mh != null) {
                    String mname #= mh.asString();
                    int32 mac2 = this.macroOf(mname);
                    if (mac2 >= 0) {
                        return #this.callMacro(mac2, args, 0 - 1,
                            0 - 1, line);
                    }
                }
            }
            int32 jid = this.handleId(cv, "__jinja_joiner__");
            if (jid >= 0) {
                JsonObject e = this.nsStore[jid].object();
                boolean used = e.get("used").asBoolean();
                if (used == false) {
                    this.registryWrite(jid, "used", Eval.bool(true));
                    return #Eval.str("");
                }
                return #Eval.copy(e.get("sep"));
            }
            this.err("value is not callable", line);
        }
        if (ck == Node.E_ATTR) {
            JsonValue obj #= this.eval(this.nd.a(callee));
            if (obj == null) {
                this.undefErr(line);
            }
            return #this.callMethod(obj, this.nd.strOf(callee), args,
                line);
        }
        this.err("unsupported call form", line);
        return null;                         // unreachable
    }

    void pushSuper(int32 node) {
        if (this.supN >= (int32) this.supStack.count()) {
            int32[] grown = heap int32[this.supN * 2];
            int32 g = 0;
            while (g < this.supN) {
                grown[g] = this.supStack[g];
                g = g + 1;
            }
            this.supStack #= grown;
        }
        this.supStack[this.supN] = node;
        this.supN = this.supN + 1;
    }

    void popSuper() {
        this.supN = this.supN - 1;
    }

    /** super(): render the enclosing block's parent level, chained. */
    #JsonValue invokeSuper(int32 line) {
        if (this.supN == 0 || this.supStack[this.supN - 1] < 0) {
            this.err("there is no parent block here", line);
        }
        int32 sup = this.supStack[this.supN - 1];
        this.pushSuper(this.nd.c(sup));
        int32 outMark = this.out.n;
        this.runChain(this.nd.b(sup));
        int32 m = this.out.n - outMark;
        int8[] produced = heap int8[m];
        int32 z = 0;
        while (z < m) {
            produced[z] = this.out.b[outMark + z];
            z = z + 1;
        }
        this.out.n = outMark;
        this.popSuper();
        JsonValue v = heap JsonValue();
        v.setStringOwned(#produced, m);
        if (this.autoescape) {
            return #this.wrapSafe(#v);
        }
        return #v;
    }

    /** N_CALLBLK: run the E_CALL with caller() wired to the block. */
    #JsonValue evalCallWithCaller(int32 call, int32 body,
            int32 params) {
        int32 line = this.nd.line(call);
        int32 callee = this.nd.a(call);
        if (this.nd.k(callee) != Node.E_NAME) {
            this.err("'{% call %}' needs a direct macro call", line);
        }
        String fn = this.nd.strOf(callee);
        int32 mac = this.macroOf(fn);
        if (mac < 0) {
            this.err("'" + fn + "' is not a defined macro", line);
        }
        return #this.callMacro(mac, this.nd.b(call), body, params,
            line);
    }

    /**
     * Invoke a macro: args evaluate in the CALLER's scope; the body
     * runs with macro visibility (top-level frame + params only) and
     * its output is captured as the macro's VALUE. cbBody/cbParams
     * carry the {% call %} block when there is one.
     */
    #JsonValue callMacro(int32 mac, int32 args, int32 cbBody,
            int32 cbParams, int32 line) {
        // Evaluate arguments before any visibility change.
        int32 posN = 0;
        int32 kwN = 0;
        int32 a = args;
        while (a >= 0) {
            if (this.nd.k(a) == Node.E_KWARG) {
                kwN = kwN + 1;
            } else {
                posN = posN + 1;
            }
            a = this.nd.nx(a);
        }
        JsonValue[] posVals = heap JsonValue[posN + 1];
        String[] kwNames = heap String[kwN + 1];
        JsonValue[] kwVals = heap JsonValue[kwN + 1];
        int32 pi = 0;
        int32 ki = 0;
        a = args;
        while (a >= 0) {
            if (this.nd.k(a) == Node.E_KWARG) {
                String kn = "" + this.nd.strOf(a);
                this.kwNamesStore(kwNames, ki, kn);
                kwVals[ki] #= this.eval(this.nd.a(a));
                ki = ki + 1;
            } else {
                posVals[pi] #= this.eval(a);
                pi = pi + 1;
            }
            a = this.nd.nx(a);
        }
        // Count declared parameters; extra positionals are loud.
        int32 params = this.nd.a(mac);
        int32 declared = 0;
        int32 w = params;
        while (w >= 0) {
            declared = declared + 1;
            w = this.nd.nx(w);
        }
        if (posN > declared) {
            this.err("macro '" + this.nd.strOf(mac) + "' takes "
                + declared + " argument(s), got " + posN, line);
        }
        // Save the caller view; install macro visibility.
        int32 savedBase = this.macroBase;
        int32 savedRoot = this.rootEnd;
        int32 savedCBody = this.callerBody;
        int32 savedCParams = this.callerParams;
        int32 savedCBase = this.callerBase;
        int32 savedCRoot = this.callerRootEnd;
        int32 newRoot = savedRoot;
        if (savedBase == 0) {
            if (this.fdepth > 1) {
                newRoot = this.fbase[1];
            } else {
                newRoot = this.depth;
            }
        }
        this.callerBody = cbBody;
        this.callerParams = cbParams;
        this.callerBase = savedBase;
        this.callerRootEnd = savedRoot;
        int32 mark = this.beginScope();
        this.macroBase = mark;
        this.rootEnd = newRoot;
        // Bind parameters: positional, then keyword, then default.
        int32 p = params;
        int32 idx = 0;
        while (p >= 0) {
            String pname = this.nd.strOf(p);
            JsonValue bound = null;
            boolean have = false;
            if (idx < posN) {
                bound #= posVals[idx];
                have = true;
            } else {
                int32 k2 = 0;
                while (k2 < kwN) {
                    if (kwNames[k2].equals(pname)) {
                        bound #= kwVals[k2];
                        have = true;
                        k2 = kwN;
                    } else {
                        k2 = k2 + 1;
                    }
                }
            }
            if (have == false && this.nd.a(p) >= 0) {
                // Defaults evaluate at CALL time in the macro's own
                // visible scope (oracle-verified).
                bound #= this.eval(this.nd.a(p));
            }
            this.push(pname, #bound);
            idx = idx + 1;
            p = this.nd.nx(p);
        }
        // Run the body, capturing its output as the macro's value.
        int32 outMark = this.out.n;
        this.runChain(this.nd.b(mac));
        int32 m = this.out.n - outMark;
        int8[] produced = heap int8[m];
        int32 z = 0;
        while (z < m) {
            produced[z] = this.out.b[outMark + z];
            z = z + 1;
        }
        this.out.n = outMark;
        this.endScope(mark);
        this.macroBase = savedBase;
        this.rootEnd = savedRoot;
        this.callerBody = savedCBody;
        this.callerParams = savedCParams;
        this.callerBase = savedCBase;
        this.callerRootEnd = savedCRoot;
        JsonValue v = heap JsonValue();
        v.setStringOwned(#produced, m);
        if (this.autoescape) {
            return #this.wrapSafe(#v);       // body escaped inline
        }
        return #v;
    }

    void kwNamesStore(String[] arr, int32 i, String s) {
        String own = "" + s;
        arr[i] #= own;
    }

    /** caller(): render the {% call %} body with CALL-SITE visibility
     *  plus the block's parameters bound to the given arguments. */
    #JsonValue invokeCaller(int32 args, int32 line) {
        if (this.callerBody < 0 && this.callerParams < 0) {
            this.err("No caller defined", line);
        }
        // Evaluate caller() args in the MACRO's scope (they reference
        // macro state), before restoring the call-site view.
        int32 n = 0;
        int32 a = args;
        while (a >= 0) {
            n = n + 1;
            a = this.nd.nx(a);
        }
        JsonValue[] argVals = heap JsonValue[n + 1];
        int32 i = 0;
        a = args;
        while (a >= 0) {
            argVals[i] #= this.eval(a);
            i = i + 1;
            a = this.nd.nx(a);
        }
        int32 savedBase = this.macroBase;
        int32 savedRoot = this.rootEnd;
        int32 savedBody = this.callerBody;
        int32 savedParams = this.callerParams;
        this.macroBase = this.callerBase;
        this.rootEnd = this.callerRootEnd;
        this.callerBody = 0 - 1;
        this.callerParams = 0 - 1;
        int32 mark = this.beginScope();
        int32 p = savedParams;
        int32 pi = 0;
        while (p >= 0) {
            JsonValue bound = null;
            if (pi < n) {
                bound #= argVals[pi];
            } else if (this.nd.a(p) >= 0) {
                bound #= this.eval(this.nd.a(p));
            }
            this.push(this.nd.strOf(p), #bound);
            pi = pi + 1;
            p = this.nd.nx(p);
        }
        int32 outMark = this.out.n;
        this.runChain(savedBody);
        int32 m = this.out.n - outMark;
        int8[] produced = heap int8[m];
        int32 z = 0;
        while (z < m) {
            produced[z] = this.out.b[outMark + z];
            z = z + 1;
        }
        this.out.n = outMark;
        this.endScope(mark);
        this.macroBase = savedBase;
        this.rootEnd = savedRoot;
        this.callerBody = savedBody;
        this.callerParams = savedParams;
        JsonValue v = heap JsonValue();
        v.setStringOwned(#produced, m);
        if (this.autoescape) {
            return #this.wrapSafe(#v);
        }
        return #v;
    }

    #JsonValue evalRange(int32 args, int32 line) {
        int64 start = 0;
        int64 stop = 0;
        int64 step = 1;
        if (args >= 0) {
            JsonValue v1 #= this.eval(args);
            stop = Eval.toI64(v1);
            int32 a2 = this.nd.nx(args);
            if (a2 >= 0) {
                start = stop;
                JsonValue v2 #= this.eval(a2);
                stop = Eval.toI64(v2);
                int32 a3 = this.nd.nx(a2);
                if (a3 >= 0) {
                    JsonValue v3 #= this.eval(a3);
                    step = Eval.toI64(v3);
                }
            }
        }
        if (step == 0) {
            this.err("range() step cannot be zero", line);
        }
        JsonArray arr = heap JsonArray();
        int64 x = start;
        while ((step > 0 && x < stop) || (step < 0 && x > stop)) {
            arr.add(Eval.num(x));
            x = x + step;
        }
        JsonValue v = heap JsonValue();
        v.setArray(#arr);
        return #v;
    }

    #String argText(int32 a, int32 line) {
        JsonValue v #= this.eval(a);
        return #this.text(v, line);
    }

    /** The supported method set (spec 2.16's "method calls match") —
     *  the string/dict methods chat templates actually use. */
    #JsonValue callMethod(JsonValue obj, String m, int32 args,
            int32 line) {
        int32 cyId = this.handleId(obj, "__jinja_cycler__");
        if (cyId >= 0) {
            JsonObject e = this.nsStore[cyId].object();
            JsonArray items = e.get("items").array();
            int32 pos = (int32) e.get("pos").asInt64();
            if (m.equals("next")) {
                JsonValue v #= Eval.copy(items.get(pos));
                int32 nxt = pos + 1;
                if (nxt >= items.count()) {
                    nxt = 0;
                }
                this.registryWrite(cyId, "pos", Eval.num((int64) nxt));
                return #= v;
            }
            if (m.equals("reset")) {
                this.registryWrite(cyId, "pos", Eval.num((int64) 0));
                JsonValue nv = heap JsonValue();
                nv.setNull();
                return #nv;
            }
            this.err("cycler has no method '." + m + "()'", line);
        }
        if (m.equals("cycle") && obj.kind() == JsonValue.OBJECT
                && obj.object().containsKey("__jinja_loop__")) {
            JsonValue iv = obj.object().get("index0");
            int64 idx = 0;
            if (iv != null) {
                idx = iv.asInt64();
            }
            int32 argc = 0;
            int32 w = args;
            while (w >= 0) {
                argc = argc + 1;
                w = this.nd.nx(w);
            }
            if (argc == 0) {
                this.err("loop.cycle() needs at least one argument",
                    line);
            }
            int32 pick = (int32) (idx % (int64) argc);
            w = args;
            while (pick > 0) {
                w = this.nd.nx(w);
                pick = pick - 1;
            }
            return #this.eval(w);
        }
        if (m.equals("items") || m.equals("keys") || m.equals("values")) {
            if (obj.kind() != JsonValue.OBJECT) {
                this.err("." + m + "() needs a mapping", line);
            }
            JsonObject o = obj.object();
            JsonArray outArr = heap JsonArray();
            int32 j = 0;
            while (j < o.count()) {
                String key #= Eval.keyOf(o, j);
                if (m.equals("keys")) {
                    outArr.add(Eval.str(key));
                } else if (m.equals("values")) {
                    outArr.add(Eval.copy(o.valueAt(j)));
                } else {
                    JsonArray pair = heap JsonArray();
                    pair.add(Eval.str(key));
                    pair.add(Eval.copy(o.valueAt(j)));
                    JsonValue pv = heap JsonValue();
                    pv.setArray(#pair);
                    outArr.add(#pv);
                }
                j = j + 1;
            }
            JsonValue v = heap JsonValue();
            v.setArray(#outArr);
            return #v;
        }
        if (m.equals("get")) {
            if (obj.kind() != JsonValue.OBJECT) {
                this.err(".get() needs a mapping", line);
            }
            if (args < 0) {
                this.err(".get() needs a key", line);
            }
            String key2 #= this.argText(args, line);
            JsonValue got = obj.object().get(key2);
            if (got != null) {
                return #Eval.copy(got);
            }
            int32 dflt = this.nd.nx(args);
            if (dflt >= 0) {
                return #this.eval(dflt);
            }
            JsonValue nv = heap JsonValue();
            nv.setNull();                    // Python .get default: None
            return #nv;
        }
        // String methods below.
        if (obj.kind() != JsonValue.STRING) {
            this.err("unsupported method '." + m + "()' on this value",
                line);
        }
        if (m.equals("strip") || m.equals("trim")) {
            return #Eval.str(obj.asString().trim());
        }
        if (m.equals("lower")) {
            return #Eval.str(obj.asString().toLowerCase());
        }
        if (m.equals("upper")) {
            return #Eval.str(obj.asString().toUpperCase());
        }
        if (m.equals("startswith")) {
            String p #= this.argText(args, line);
            return #Eval.bool(obj.asString().startsWith(p));
        }
        if (m.equals("endswith")) {
            String q #= this.argText(args, line);
            return #Eval.bool(obj.asString().endsWith(q));
        }
        if (m.equals("replace")) {
            if (args < 0 || this.nd.nx(args) < 0) {
                this.err(".replace() needs two arguments", line);
            }
            String from #= this.argText(args, line);
            String to #= this.argText(this.nd.nx(args), line);
            return #Eval.str(Eval.replaceAll(obj.asString(), from, to));
        }
        if (m.equals("split")) {
            String s #= obj.asString();
            JsonArray parts = heap JsonArray();
            if (args < 0) {
                // No separator: split on whitespace RUNS, dropping
                // leading/trailing — Python semantics.
                int32 n = s.byteLength();
                int32 x = 0;
                while (x < n) {
                    while (x < n && Eval.isWs(s.byteAt(x))) {
                        x = x + 1;
                    }
                    int32 st = x;
                    while (x < n && Eval.isWs(s.byteAt(x)) == false) {
                        x = x + 1;
                    }
                    if (x > st) {
                        parts.add(Eval.str(s.substring(st, x)));
                    }
                }
            } else {
                String sep #= this.argText(args, line);
                int32 n2 = s.byteLength();
                int32 m2 = sep.byteLength();
                if (m2 == 0) {
                    this.err("empty separator in .split()", line);
                }
                int32 st2 = 0;
                int32 x2 = 0;
                while (x2 + m2 <= n2) {
                    boolean hit = true;
                    int32 j2 = 0;
                    while (j2 < m2) {
                        if (s.byteAt(x2 + j2) != sep.byteAt(j2)) {
                            hit = false;
                            j2 = m2;
                        } else {
                            j2 = j2 + 1;
                        }
                    }
                    if (hit) {
                        parts.add(Eval.str(s.substring(st2, x2)));
                        x2 = x2 + m2;
                        st2 = x2;
                    } else {
                        x2 = x2 + 1;
                    }
                }
                parts.add(Eval.str(s.substring(st2, n2)));
            }
            JsonValue v2 = heap JsonValue();
            v2.setArray(#parts);
            return #v2;
        }
        this.err("unsupported method '." + m + "()'", line);
        return null;                         // unreachable
    }

    static boolean isWs(int32 c) {
        return c == 32 || c == 9 || c == 10 || c == 13;
    }

    static #String replaceAll(String s, String from, String to) {
        Buf b = heap Buf();
        int32 n = s.byteLength();
        int32 m = from.byteLength();
        int32 i = 0;
        while (i < n) {
            boolean hit = false;
            if (m > 0 && i + m <= n) {
                hit = true;
                int32 j = 0;
                while (j < m) {
                    if (s.byteAt(i + j) != from.byteAt(j)) {
                        hit = false;
                        j = m;
                    } else {
                        j = j + 1;
                    }
                }
            }
            if (hit) {
                b.addStr(to);
                i = i + m;
            } else {
                b.addByte(s.byteAt(i));
                i = i + 1;
            }
        }
        return #b.take();
    }
}
