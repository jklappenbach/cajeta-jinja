package dev.cajeta.jinja;

import cajeta.codec.json.JsonValue;
import cajeta.lang.String;

/**
 * A compiled template (spec 5.2): renders repeatedly against different
 * contexts without reparsing. Construction snapshots the Environment's
 * settings and runs the WHOLE front half — lex + parse — so a parse
 * error surfaces at compile() with line and column (spec 5.3), and a
 * Template that constructed successfully cannot fail to parse later.
 *
 * The compiled form is the flat `Node` table, which owns every string
 * payload — the source text, the token stream, and the Lexer all drop
 * at the end of this constructor (spec 3.2's discipline applied to the
 * AST itself).
 *
 * UNIT 3 STATE: text and `{{ expression }}` output render with the full
 * expression grammar; statement tags fail loudly at compile time naming
 * keyword and line (spec 2.22). Unit 4 brings statements.
 */
public final class Template {
    Node nd;
    boolean strictUndefinedFlag;
    boolean autoescapeFlag;
    int64 nowEpochSecondsVal;

    public Template(String source, boolean trimBlocks, boolean lstripBlocks,
                    boolean autoescape, boolean strictUndefined,
                    int64 nowEpochSeconds) {
        this.autoescapeFlag = autoescape;
        this.strictUndefinedFlag = strictUndefined;
        this.nowEpochSecondsVal = nowEpochSeconds;
        Lexer lx = heap Lexer(source, trimBlocks, lstripBlocks);
        Tok toks = lx.tokenize();
        this.nd #= Parser.parse(toks);
    }

    /**
     * Render against a context. The result is a fresh owned String
     * (producer, §2.1); `context` is read for the duration of the call
     * and never captured — every value the evaluator keeps is a copy.
     */
    public #String render(JsonValue context) {
        Eval ev = heap Eval();
        ev.nd = this.nd;
        ev.ctx = context;
        ev.strict = this.strictUndefinedFlag;
        ev.nowEpoch = this.nowEpochSecondsVal;
        return #ev.render();
    }
}
