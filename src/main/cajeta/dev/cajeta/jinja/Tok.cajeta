package dev.cajeta.jinja;

import cajeta.lang.String;

/**
 * The token stream — flat, index-based (plan 2.2.3: an allocation per
 * node buys nothing when every traversal is an index walk).
 *
 * Parallel arrays, one row per token:
 *   kind[i]  — a K_* constant
 *   a[i]     — payload start into `bytes` (TEXT/NAME/STRING/NUMBER),
 *              else 0
 *   b[i]     — payload length, else 0
 *   line[i]  — 1-based template line the token starts on
 *   col[i]   — 1-based column the token starts at
 *
 * TEXT rows carry template text AFTER whitespace control was applied.
 * STRING rows carry UNESCAPED bytes. NUMBER rows carry the literal's
 * raw text (Unit 3's evaluator parses it — int vs float stays visible).
 */
public final class Tok {

    // structural
    public static final int32 K_EOF = 0;
    public static final int32 K_TEXT = 1;
    public static final int32 K_VAR_OPEN = 2;      // {{  ({{- already applied)
    public static final int32 K_VAR_CLOSE = 3;     // }}
    public static final int32 K_STMT_OPEN = 4;     // {%
    public static final int32 K_STMT_CLOSE = 5;    // %}
    // atoms
    public static final int32 K_NAME = 6;
    public static final int32 K_STRING = 7;
    public static final int32 K_NUMBER = 8;
    // punctuation / operators
    public static final int32 K_LPAREN = 9;
    public static final int32 K_RPAREN = 10;
    public static final int32 K_LBRACKET = 11;
    public static final int32 K_RBRACKET = 12;
    public static final int32 K_LBRACE = 13;
    public static final int32 K_RBRACE = 14;
    public static final int32 K_COMMA = 15;
    public static final int32 K_COLON = 16;
    public static final int32 K_DOT = 17;
    public static final int32 K_PIPE = 18;
    public static final int32 K_TILDE = 19;
    public static final int32 K_PLUS = 20;
    public static final int32 K_MINUS = 21;
    public static final int32 K_STAR = 22;
    public static final int32 K_DSTAR = 23;        // **
    public static final int32 K_SLASH = 24;
    public static final int32 K_DSLASH = 25;       // //
    public static final int32 K_PERCENT = 26;
    public static final int32 K_ASSIGN = 27;       // =
    public static final int32 K_EQ = 28;           // ==
    public static final int32 K_NE = 29;           // !=
    public static final int32 K_LT = 30;
    public static final int32 K_LE = 31;
    public static final int32 K_GT = 32;
    public static final int32 K_GE = 33;

    public int32[] kind;
    public int32[] a;
    public int32[] b;
    public int32[] line;
    public int32[] col;
    public int32 n;

    // Payload bytes for TEXT/NAME/STRING/NUMBER rows.
    Buf bytes;

    /** Payload bytes of token `i` as an owned String. */
    public #String spanText(int32 i) {
        int32 s = this.a[i];
        int32 m = this.b[i];
        int8[] exact = heap int8[m];
        int32 j = 0;
        while (j < m) {
            exact[j] = this.bytes.b[s + j];
            j = j + 1;
        }
        return heap String(#exact, m);
    }

    Tok() {
        this.kind = heap int32[64];
        this.a = heap int32[64];
        this.b = heap int32[64];
        this.line = heap int32[64];
        this.col = heap int32[64];
        this.n = 0;
        this.bytes = heap Buf();
    }

    void ensure() {
        if (this.n < (int32) this.kind.count()) {
            return;
        }
        int32 cap = (int32) this.kind.count() * 2;
        int32[] k2 = heap int32[cap];
        int32[] a2 = heap int32[cap];
        int32[] b2 = heap int32[cap];
        int32[] l2 = heap int32[cap];
        int32[] c2 = heap int32[cap];
        int32 i = 0;
        while (i < this.n) {
            k2[i] = this.kind[i];
            a2[i] = this.a[i];
            b2[i] = this.b[i];
            l2[i] = this.line[i];
            c2[i] = this.col[i];
            i = i + 1;
        }
        this.kind #= k2;
        this.a #= a2;
        this.b #= b2;
        this.line #= l2;
        this.col #= c2;
    }

    int32 add(int32 k, int32 ln, int32 cl) {
        this.ensure();
        this.kind[this.n] = k;
        this.a[this.n] = 0;
        this.b[this.n] = 0;
        this.line[this.n] = ln;
        this.col[this.n] = cl;
        this.n = this.n + 1;
        return this.n - 1;
    }

    void setSpan(int32 tok, int32 start, int32 len) {
        this.a[tok] = start;
        this.b[tok] = len;
    }
}
